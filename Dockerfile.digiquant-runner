# digiquant-runner — one image on DigiQuantRunnerContainer (issue #4761).
# Build context is the monorepo root. wrangler pins
# image_build_context = "../.." from apps/digiquant-runner/wrangler.toml (#4046).
#
# The image code pin is the released main tree baked at build time.
# The hot path inside commands.json is `uv run --frozen --no-sync`
# except the tearsheet Coinbase step, which keeps `uv run --frozen --with ccxt`.
# Sync installs digiquant with prices, research, and nautilus, then an
# inexact digigraph sync with checkpoint-postgres so the house chain can
# import langgraph-checkpoint-postgres. --inexact is required: the second
# sync must not remove psycopg[binary] that the research extra installed.
# The 1.230.0 cp312 manylinux x86_64
# wheel is 182608916 bytes (uv.lock). One class, instance_type standard-2.
# No DigiQuantRunnerNautilusContainer. No DigiQuantHouseContainer.
#
# Task 0 probe (not a guess): phase2 Size=1274551802 (~1.187 GiB);
# house-candidate Size=1344917045 (~1.253 GiB). Hard stop: no.
# Phase 4 (#4761) copies the two checkpoint-archive scripts after uv sync.
# Those COPY lines do not change the sync layers. Hard stop stays 12 GiB.
#
# GIT_SHA defaults to unknown. wrangler does not pass build args here;
# a non-wrangler build can set --build-arg GIT_SHA=<sha>. /healthz reports
# the sha from the latest job status, which reads DIGIQUANT_RUNNER_GIT_SHA.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:/usr/local/bin:${PATH}" \
    RUNNER_WORKDIR=/app

RUN pip install --upgrade pip && pip install uv

COPY pyproject.toml uv.lock ./
COPY digibase ./digibase
COPY digikey ./digikey
COPY digifetch ./digifetch
COPY digiquant ./digiquant
COPY digigraph ./digigraph
COPY digillm ./digillm
COPY digitrace ./digitrace
COPY config/byok-providers.json ./config/byok-providers.json
# Second fail-loud-at-import config file: model_config._load_model_policy. The house
# chain steps run digigraph in-process, so this image needs it for the same reason it
# needs byok-providers.json. See digigraph/Dockerfile.
COPY config/model-policy.json ./config/model-policy.json
# Third config file, and the only one this image loads *softly*. digiquant's
# research.pricing resolves the repo root to /app, and this image ships a
# /app/config/ directory that already holds the two files above -- so an
# omitted prices file is not a missing-directory warning, it is a silently
# empty price table, and diagnostics.est_cost_usd would report $0 for every
# model while the telemetry spend alert could never fire. Copy it.
COPY config/digiquant-model-prices.json ./config/digiquant-model-prices.json

RUN uv sync --frozen --package digiquant --extra prices --extra research --extra nautilus \
    && uv sync --frozen --inexact --package digigraph --extra checkpoint-postgres

COPY scripts/refresh_market_data_r2.py ./scripts/refresh_market_data_r2.py
COPY scripts/backfill_market_data_r2.py ./scripts/backfill_market_data_r2.py
COPY scripts/execution_cron_check.py ./scripts/execution_cron_check.py
COPY scripts/digiquant_archive_checkpoints.py ./scripts/digiquant_archive_checkpoints.py
COPY scripts/digiquant_checkpoint_size_gate.py ./scripts/digiquant_checkpoint_size_gate.py
COPY .github/digiquant-pipeline.yml ./.github/digiquant-pipeline.yml
COPY .github/workflows/pipeline-digiquant-allocation-shadow.yml \
    ./.github/workflows/pipeline-digiquant-allocation-shadow.yml
COPY apps/digiquant-runner/container/exec_job.py /opt/runner/exec_job.py
COPY apps/digiquant-runner/container/house_chain_step.py /opt/runner/house_chain_step.py
COPY apps/digiquant-runner/container/wake_stack.py /opt/runner/wake_stack.py
COPY apps/digiquant-runner/container/web_search_preflight.py /opt/runner/web_search_preflight.py
COPY apps/digiquant-runner/commands.json /opt/runner/commands.json

ARG GIT_SHA=unknown
ENV DIGIQUANT_RUNNER_GIT_SHA=${GIT_SHA}

EXPOSE 8080

CMD ["python", "/opt/runner/exec_job.py", "serve"]
