# digiquant-runner — one image on DigiQuantRunnerContainer (issue #4761).
# Build context is the monorepo root. wrangler pins
# image_build_context = "../.." from apps/digiquant-runner/wrangler.toml (#4046).
#
# The image code pin is the released main tree baked at build time.
# The hot path inside commands.json is `uv run --frozen --no-sync`
# except the tearsheet Coinbase step, which keeps `uv run --frozen --with ccxt`.
# Sync installs digiquant with prices, research, and nautilus, then an
# inexact digigraph sync with checkpoint-postgres so the house chain can
# import langgraph-checkpoint-postgres. --inexact is required: the second
# sync must not remove psycopg[binary] that the research extra installed.
# The 1.230.0 cp312 manylinux x86_64
# wheel is 182608916 bytes (uv.lock). One class, instance_type standard-2.
# No DigiQuantRunnerNautilusContainer. No DigiQuantHouseContainer.
#
# Task 0 probe (not a guess): phase2 Size=1274551802 (~1.187 GiB);
# house-candidate Size=1344917045 (~1.253 GiB). Hard stop: no.
# Phase 4 (#4761) copies the two checkpoint-archive scripts after uv sync.
# Those COPY lines do not change the sync layers. Hard stop stays 12 GiB.
#
# GIT_SHA defaults to unknown. wrangler does not pass build args here;
# a non-wrangler build can set --build-arg GIT_SHA=<sha>. /healthz reports
# the sha from the latest job status, which reads DIGIQUANT_RUNNER_GIT_SHA.
#
# DIG-3701: do not COPY sibling module trees. scripts/package_r5_image_inputs.py
# exports the root lock with `uv export --frozen` for
# digiquant[prices,research,nautilus] and digigraph[checkpoint-postgres]
# (the second sync stays inexact by union, not by a second sync that would
# remove psycopg), builds the workspace wheels, and packs the runner payload.
# `uv sync --frozen` installs that generated project. Push target default is
# the Cloudflare container registry (D-R5-1). Not GHCR. Not a client registry.
# This file does not log in and does not push.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:/usr/local/bin:${PATH}" \
    RUNNER_WORKDIR=/app

RUN pip install --upgrade pip && pip install uv

# D-R5-1. Account id is supplied by the operator at push time (H3). The
# default host is the Cloudflare container registry.
ARG IMAGE_PUSH_REGISTRY=registry.cloudflare.com
ARG IMAGE_PUSH_REPOSITORY=digithings/digiquant-runner
LABEL org.digithings.image.registry="${IMAGE_PUSH_REGISTRY}" \
      org.digithings.image.repository="${IMAGE_PUSH_REPOSITORY}"

COPY image-packages/runner/project/pyproject.toml image-packages/runner/project/uv.lock ./
COPY image-packages/runner/project/wheels ./wheels
# Frozen pins: the lock is `uv export --frozen` of the workspace lock for
# digiquant[prices,research,nautilus] plus digigraph[checkpoint-postgres],
# then `uv lock` with those exact pins. --no-install-project skips the
# synthetic project; the wheels install from ./wheels.
RUN uv sync --frozen --no-install-project --no-dev

# Payload paths match commands.json and DIGI_CONFIG_PATH. The prices file is
# required: research.pricing treats a present /app/config without it as an
# empty table, and diagnostics.est_cost_usd would report $0.
COPY image-packages/runner/payload/scripts ./scripts
COPY image-packages/runner/payload/config ./config
COPY image-packages/runner/payload/digiquant ./digiquant
COPY image-packages/runner/payload/.github ./.github
COPY image-packages/runner/payload/opt/runner/ /opt/runner/
ENV DIGI_CONFIG_PATH=/app/config

ARG GIT_SHA=unknown
ENV DIGIQUANT_RUNNER_GIT_SHA=${GIT_SHA}

EXPOSE 8080

CMD ["python", "/opt/runner/exec_job.py", "serve"]
