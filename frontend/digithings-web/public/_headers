# Cloudflare Pages headers for digithings.ai. Fonts are self-hosted (next/font).
# frame-src 'self' — DigiChat is same-origin at /embed (CF route → DigiThings Node).
# X-Frame-Options: DENY still blocks digithings.ai itself from being framed.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
