# Dashboard environment — copy to `.env.local` and fill in.
# All client-exposed vars MUST be prefixed NEXT_PUBLIC_.

# ── Core Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── App auth (T1 — Supabase Auth login, static-export PKCE) ─────────────────
# Default OFF. When unset or anything other than "1", the dashboard behaves
# exactly as today (anon client + Cloudflare Access edge gate). Set to "1"
# at build time to enable Google/GitHub OAuth login; signed-out users see
# the login UI. Cutover also requires dropping anon RLS policies (T0
# migration, coordinated release) and removing Cloudflare Access from
# production /dashboard/* (owner).
# NEXT_PUBLIC_DASHBOARD_AUTH=1

# Optional: dashboard mount path (default /dashboard). Used by dashboardBasePath().
# NEXT_PUBLIC_DASHBOARD_BASE_PATH=/dashboard
# Optional: footer version label.
# NEXT_PUBLIC_DASHBOARD_VERSION=
# Optional: route snapshot reads through a /api/snapshots BFF instead of anon Supabase.
# NEXT_PUBLIC_DASHBOARD_USE_BFF=1

# ── Settings / brokers / billing (T3) ─────────────────────────────────────────
# Alpaca OAuth client id is public (authorize URL). The client *secret* stays
# only on the settings Edge Function (ALPACA_OAUTH_CLIENT_SECRET) — never here.
# NEXT_PUBLIC_ALPACA_OAUTH_CLIENT_ID=
# Optional override for Edge Functions base (defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1).
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=
# Set to "0" to force the Billing tab's "billing not configured" empty state.
# NEXT_PUBLIC_STRIPE_BILLING_ENABLED=1


# ── digichat popup (Desk+ research / portfolio — #3422 / #3581 / #3638) ──────
# Bottom-right launcher iframes digichat /embed (digigraph → digillm, not
# vendor-direct). Default-on with origin https://digithings.ai and host
# digiquant.io. Kill with POPUP=0. Origin must stay in CSP frame-src.
# digiquant.io does not need EMBED_TOKEN (operator host). Third-party hosts do.
# Launcher chrome is always rectangular “ask digichat” (#3581); POPUP_MODE is
# accepted for back-compat but does not restore the old round ✦.
# Page context posts sanitized HTML (+ text) after digichat:ready (HTML ≤12k,
# text ≤8k). Screenshot/vision multimodal is deferred.
# Register digiquant.io in digichat DIGICHAT_EMBED_TENANTS with
# backend.type=digigraph, webSearch=true, showByok=true, digisearchIndex for
# house research/portfolio corpus.
#
# Local dogfood (dashboard :4014 + digichat :3005):
#   NEXT_PUBLIC_DIGICHAT_EMBED_ORIGIN=http://127.0.0.1:3005
#   NEXT_PUBLIC_DIGICHAT_EMBED_HOST=localhost
#   NEXT_PUBLIC_DIGICHAT_POPUP=1
#   NEXT_PUBLIC_DIGICHAT_PAGE_CONTEXT=1
# Open http://127.0.0.1:4014/dashboard/ as Desk+; click the corner launcher.
# Production digichat will refuse to frame localhost — use the loopback origin.
# Optional production overrides (defaults are origin+host above; POPUP=0 kills):
# NEXT_PUBLIC_DIGICHAT_EMBED_ORIGIN=https://digithings.ai
# NEXT_PUBLIC_DIGICHAT_EMBED_HOST=digiquant.io
# NEXT_PUBLIC_DIGICHAT_POPUP=1
# NEXT_PUBLIC_DIGICHAT_PAGE_CONTEXT=1

# ── twelve-x FX Research suite (UNLINKED / gated) ───────────────────────────
# The FX Research suite is hidden by default. Set this to "1" to surface its
# sidebar entry and route (/twelve-x).
# NEXT_PUBLIC_TWELVEX_ENABLED=1

# Dedicated twelve-x Supabase project. When UNSET, the FX fetchers fall back to
# the main NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY above — so a
# shared project needs no extra config. Set these only when twelve-x lives in a
# separate Supabase project.
# NEXT_PUBLIC_TWELVEX_SUPABASE_URL=
# NEXT_PUBLIC_TWELVEX_SUPABASE_ANON_KEY=
