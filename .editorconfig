# EditorConfig — https://editorconfig.org
# Matches the repo: ruff line length 100, Python indent 4, JS/TS/YAML indent 2.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4

[*.{md,mdx}]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
