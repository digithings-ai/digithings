# Root build context is shared by every service compose builds with `context: .`
# (digikey, digigraph, digiquant, digismith, digiclaw, digichat). Their
# Dockerfiles COPY the service source dirs, so exclude only what no image needs.
.git
.github
.worktrees
.claude
.playwright-mcp
node_modules
**/node_modules
**/.next
**/out
dist
data
docs
projects
openspec
tests
scripts
# Dockerfile.digithings-stack-cloudflare (Cloudflare Containers, root context)
# needs this one file; re-include it without un-ignoring the rest of scripts/.
!scripts/merge_litellm_cheaperinference.py
# Zammad MCP server (scripts/zammad_mcp/Dockerfile.mcp) also builds from the
# root context; re-include just that package.
!scripts/zammad_mcp
# OCC ticket-search seeding (#4987): seed_chroma.sh runs
# `python3 -m scripts.build_occ_tickets_seed --ingest /seed/occ_tickets.jsonl`,
# which imports scripts.index_occ_tickets. Both COPY lines were added to the
# stack Dockerfile without these re-includes, so the image build failed with
# "failed to calculate checksum ... /scripts/build_occ_tickets_seed.py: not
# found" (#4988). tests/scripts/test_stack_dockerignore_context.py pins every
# `COPY scripts/<file>` in the stack Dockerfile against this list.
!scripts/index_occ_tickets.py
!scripts/build_occ_tickets_seed.py
agents
apps/digithings-web
apps/digiquant-web
**/*.log
.env
.env.*
!.env.example
