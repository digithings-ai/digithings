# Local browser bridge only. The client rejects non-loopback URLs and refuses
# to connect when the site itself is not running on a loopback hostname.
NEXT_PUBLIC_DIGIQUANT_GATEWAY_URL=http://127.0.0.1:8792

# Official digiquant read API (dashboard-api). Unset, loopback previews use the
# /official-api dev proxy and every other host uses https://graph.digithings.ai/dashboard-api.
# NEXT_PUBLIC_DASHBOARD_API_URL=http://127.0.0.1:8788
# NEXT_PUBLIC_DQ_API_URL=

# Optional. The deployed R2-backed market worker that serves live portfolio prices.
# Unset, the live panels stay empty rather than falling back to anything else.
# Local preview may point this at the loopback gateway; production must not.
# NEXT_PUBLIC_MARKET_DATA_URL=
