# Local browser bridge only. The client rejects non-loopback URLs and refuses
# to connect when the site itself is not running on a loopback hostname.
NEXT_PUBLIC_DIGIQUANT_GATEWAY_URL=http://127.0.0.1:8792

# Reuse the same gateway for the existing market-data browser seam.
NEXT_PUBLIC_MARKET_DATA_URL=http://127.0.0.1:8792
