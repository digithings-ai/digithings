{
  "name": "digidata-api",
  "description": "Worker data API over D1 with a Supabase fallback.",
  "license": "MIT",
  "homepage": "https://digithings.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digithings-ai/digithings.git",
    "directory": "apps/digidata-api"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler-state",
    "d1:local:twelvex": "wrangler d1 execute twelvex --local --persist-to .wrangler-state --file d1/twelvex/0001_init.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.28.0"
  }
}
