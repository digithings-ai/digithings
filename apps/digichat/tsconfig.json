{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@digithings/ui/ui": ["../../packages/ui/src/ui"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "cli", "reference", "**/*.test.ts", "**/*.test.tsx"]
}
