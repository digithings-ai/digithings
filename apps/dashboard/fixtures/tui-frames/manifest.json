    },
    {
      "source": "digichat-tui",
      "path": "/thread",
      "file": "digichat-tui.json",
      "exporter": "clients/digichat-tui/src/export-frame.ts"
    },
    {
      "source": "digivoice-tui",
      "path": "/setup",
      "file": "digivoice-tui.json",
      "exporter": "clients/digivoice-tui/src/export-frame.ts"
    }
  ],
  "screenshots": [
