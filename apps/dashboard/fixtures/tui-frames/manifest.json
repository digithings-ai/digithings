{
  "version": 1,
  "description": "Recorded TUI frames committed for the D9 recorded-frame preview (DIG-2698). Each frame is written by the exporter named in its entry; the exporter test re-renders the client and compares the result with the committed file.",
  "frames": [
    {
      "source": "digiquant-tui",
      "path": "/brief",
      "file": "digiquant-tui.json",
