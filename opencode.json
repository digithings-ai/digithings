{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "api": "openai",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "lm-studio"
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "lmstudio/qwen/qwen3.8-27b",
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"; export GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token)\"; exec github-mcp-server stdio"
        ]
      },
      "supabase-twelve-x": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=lfghjucjrsabiqwxerxv"
      },
      "supabase-core": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=rwagjbkvxkdwqmouagad"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"; exec npx -y @playwright/mcp@0.0.79"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"; exec npx -y chrome-devtools-mcp@1.7.0"
        ]
      },
      "x": {
        "type": "remote",
        "url": "https://api.x.com/mcp"
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-bindings": {
        "type": "remote",
        "url": "https://bindings.mcp.cloudflare.com/mcp"
      },
      "cloudflare-builds": {
        "type": "remote",
        "url": "https://builds.mcp.cloudflare.com/mcp"
      },
      "cloudflare-observability": {
        "type": "remote",
        "url": "https://observability.mcp.cloudflare.com/mcp"
      }
    }
  }
}
