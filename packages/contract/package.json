{
  "name": "@digithings-ai/contract",
  "version": "0.1.0",
  "description": "Shared types and pure functions for the digiquant desk and dashboard-api. No React, no DOM, no I/O.",
  "license": "MIT",
  "homepage": "https://digithings.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digithings-ai/digithings.git",
    "directory": "packages/contract"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./accounting-views": "./src/accounting-views.ts",
    "./benchmark-tickers": "./src/benchmark-tickers.ts",
    "./book-reconciliation": "./src/book-reconciliation.ts",
    "./brief-book-event": "./src/brief-book-event.ts",
    "./dashboard-ssot": "./src/dashboard-ssot.ts",
    "./performance-ssot": "./src/performance-ssot.ts",
    "./position-event-economics": "./src/position-event-economics.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@digithings-ai/perf-math": "0.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
