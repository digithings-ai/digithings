{
  "name": "@digithings-ai/catalog",
  "version": "0.1.0",
  "description": "Framework-neutral shared catalogs: BYOK provider catalog + OpenAPI service registry. No React, no Next.js, no app aliases \u2014 importable from any runtime.",
  "license": "MIT",
  "homepage": "https://digithings.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digithings-ai/digithings.git",
    "directory": "packages/catalog"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./byok-providers": "./src/byok-providers.ts",
    "./openapi": "./src/openapi.ts",
    "./page-context-sanitize": "./src/page-context-sanitize.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
