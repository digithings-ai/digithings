# Copy to mcp.secrets.env (same directory) and fill in. Never commit mcp.secrets.env.
# Loaded automatically by Python ingest scripts (with supabase.env).
# For Cursor / Claude Desktop MCP: export these before starting the app, or use direnv (see config/MCP-SETUP.md).

FRED_API_KEY=replace-with-your-fred-api-key
# Retired 2026-10-04 (DIG-337): the MCP servers these fed were removed. The rows stay
# so the credential guard keeps scanning this file for unplaceholdered values.
COINGECKO_API_KEY=replace-with-your-coingecko-api-key
# Retired 2026-10-04 (DIG-337) — same reason as the row above.
ALPHA_VANTAGE_API_KEY=replace-with-your-alpha-vantage-api-key
# SEC policy: identify yourself (not a secret, but keep with other MCP vars)
# For Cursor `sec-edgar` MCP (ad-hoc filing lookup). Not used by automated repo ingest.
SEC_EDGAR_USER_AGENT=Your Name (your@email.com)
