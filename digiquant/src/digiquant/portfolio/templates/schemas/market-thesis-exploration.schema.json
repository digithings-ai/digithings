{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "digiquant-atlas Market Thesis Exploration",
  "description": "Track B Phase 1 \u2014 market-facing theses from research only (no portfolio weights or user mandate). Prefer document_delta when refining the same dated exploration doc.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_type",
    "date",
    "meta",
    "body"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "doc_type": {
      "type": "string",
      "const": "market_thesis_exploration"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "run_type": {
      "type": "string",
      "enum": [
        "baseline",
        "delta"
      ],
      "description": "Aligns with digest run_type when same-day digest exists; optional."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_refs"
      ],
      "properties": {
        "digest_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "baseline_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Week anchor when using changelog / manifest."
        },
        "research_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_kind",
              "ref_id"
            ],
            "properties": {
              "ref_kind": {
                "type": "string",
                "enum": [
                  "document_key",
                  "changelog_item",
                  "snapshot_path",
                  "note"
                ]
              },
              "ref_id": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            }
          }
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executive_digest_pointer",
        "theses"
      ],
      "properties": {
        "executive_digest_pointer": {
          "type": "string",
          "description": "Short overview; may reference digest sections by path or heading."
        },
        "deeper_dives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "thesis_id",
              "topic_key",
              "action",
              "title",
              "direction",
              "statement",
              "validation_criteria",
              "invalidation_criteria"
            ],
            "properties": {
              "thesis_id": {
                "type": "string"
              },
              "topic_key": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "update"
                ]
              },
              "existing_thesis_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "headwinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tailwinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bull_case": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bear_case": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sub_theses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "claim"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "claim": {
                      "type": "string"
                    },
                    "validation_criteria": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "invalidation_criteria": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "validation_criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "invalidation_criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "linked_research_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref_kind",
                    "ref_id"
                  ],
                  "properties": {
                    "ref_kind": {
                      "type": "string",
                      "enum": [
                        "document_key",
                        "changelog_item",
                        "snapshot_path",
                        "note"
                      ]
                    },
                    "ref_id": {
                      "type": "string"
                    }
                  }
                }
              },
              "horizon": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "short_term",
                  "long_term",
                  null
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
