{
  "$defs": {
    "ActionableItem": {
      "additionalProperties": false,
      "description": "One actionable summary entry. Mirrors phase7_synthesis.ActionableItem.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "priority",
        "label",
        "rationale"
      ],
      "title": "ActionableItem",
      "type": "object"
    },
    "DigestPayload": {
      "additionalProperties": true,
      "description": "Frontend-facing copy of the Phase 7 master briefing payload.\n\n**This duplicates** ``digiquant.olympus.atlas.phases.phase7_synthesis.DigestSnapshot``\non purpose \u2014 see module docstring for the import-direction rationale. The\nparity test enforces drift detection.\n\nLayout: markdown ``body`` plus a thin envelope. Historical JSON slots are\nallowed extras so old ``daily_snapshots`` rows still validate.\n\n``actionable_summary`` / ``risk_radar`` / ``material_findings`` stay typed\nso read-path personalization (#312) still sees ActionableItem / RiskItem /\nFinding objects. The stitcher ``DigestSnapshot`` does not require them.",
      "properties": {
        "actionable_summary": {
          "items": {
            "$ref": "#/$defs/ActionableItem"
          },
          "title": "Actionable Summary",
          "type": "array"
        },
        "body": {
          "default": "",
          "title": "Body",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "material_findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Material Findings",
          "type": "array"
        },
        "regime_label": {
          "default": "",
          "description": "Short regime token, e.g. 'Risk-on / Policy easing' \u2014 NOT a restatement of the regime section.",
          "title": "Regime Label",
          "type": "string"
        },
        "risk_radar": {
          "items": {
            "$ref": "#/$defs/RiskItem"
          },
          "title": "Risk Radar",
          "type": "array"
        },
        "segment": {
          "default": "master-digest",
          "title": "Segment",
          "type": "string"
        },
        "segment_freshness": {
          "additionalProperties": {
            "$ref": "#/$defs/SegmentFreshness"
          },
          "title": "Segment Freshness",
          "type": "object"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "date"
      ],
      "title": "DigestPayload",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One material finding. Mirrors digiquant.olympus.atlas.segments.Finding.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "label",
        "summary"
      ],
      "title": "Finding",
      "type": "object"
    },
    "RiskItem": {
      "additionalProperties": false,
      "description": "One risk-radar entry. Mirrors phase7_synthesis.RiskItem.",
      "properties": {
        "horizon_hours": {
          "maximum": 168,
          "minimum": 1,
          "title": "Horizon Hours",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "horizon_hours",
        "label",
        "trigger"
      ],
      "title": "RiskItem",
      "type": "object"
    },
    "SegmentFreshness": {
      "additionalProperties": false,
      "description": "Per-segment provenance marker used by the dashboard.\n\nMirrors :class:`digiquant.olympus.atlas.phases.phase7_synthesis.SegmentFreshness`.\n\n``frozen`` (#1749): regenerated today, but the edit merge changed nothing, so ``as_of`` is\nthe date the content last materially changed. This model is the READ-path validator and is\n``extra=\"forbid\"`` \u2014 a value the writer can emit but this ``Literal`` does not list is a\n``ValidationError`` on every subsequent read of the row, not a soft ignore. Widen both\ncopies in the same change.",
      "properties": {
        "as_of": {
          "description": "ISO date string ('' if unknown)",
          "title": "As Of",
          "type": "string"
        },
        "source": {
          "enum": [
            "today",
            "baseline",
            "frozen"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "as_of"
      ],
      "title": "SegmentFreshness",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "One cited source. Mirrors digiquant.olympus.atlas.segments.Source.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frontend-consumable wrapper around a ``daily_snapshots`` row.\n\nLayout (top-level keys ordered for human-readability when serialized):\n\n- ``schema_version`` \u2014 int; bump on breaking changes (see module docstring).\n- ``run_date`` \u2014 the trading date the digest was synthesized for.\n- ``run_type`` \u2014 ``\"baseline\"`` (Sunday weekly) or ``\"delta\"`` (weekday).\n- ``baseline_date`` \u2014 for delta runs, the most recent baseline this delta\n  builds on; ``None`` on a baseline run.\n- ``published_at`` \u2014 UTC timestamp the envelope was assembled.\n- ``digest`` \u2014 the validated :class:`DigestPayload`.",
  "properties": {
    "baseline_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Date"
    },
    "digest": {
      "$ref": "#/$defs/DigestPayload"
    },
    "published_at": {
      "description": "UTC timestamp the envelope was assembled",
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "run_date": {
      "format": "date",
      "title": "Run Date",
      "type": "string"
    },
    "run_type": {
      "enum": [
        "baseline",
        "delta"
      ],
      "title": "Run Type",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "description": "Envelope schema version",
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_date",
    "run_type",
    "digest"
  ],
  "title": "SnapshotEnvelope",
  "type": "object"
}
