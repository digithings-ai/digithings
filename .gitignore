# Digi Ecosystem – root .gitignore

# Claude Code agent worktrees (ephemeral copies; do not commit)
.claude/worktrees/
/.worktrees/

# Local Claude Code overrides (tokens, paths — never commit)
.claude/settings.local.json

# Claude Code runtime state (scheduler lock, transient)
.claude/scheduled_tasks.lock

# npm output at any depth. Deliberately NOT anchored: `npm ci` at the repo root
# materializes nested node_modules in any workspace whose dep version cannot be hoisted
# — package-lock.json carries such `frontend/*/node_modules/...` entries today — and an
# anchored rule leaves those untracked. Coverage otherwise falls to each workspace
# shipping its own .gitignore; frontend/digiweb/design ships none, so this rule is its
# only cover.
node_modules/

# Cloudflare Pages Functions for digithings.ai are authored under
# frontend/digithings-web/functions/ and mirrored to a repo-root functions/ by
# scripts/build-digithings.sh at build time (CF requires functions/ at the project
# root). The generated copy is a build artifact — never commit it.
/functions/

.venv/
.venv-ci/
venv/
.env
projects/*/.env
config/dogfood-digiproject.local.yaml
docker-compose.override.yml

# Confidential: project configs and deployments (never share)
# Anchored to repo root so docs/projects/ (public dogfooding projects) is not captured.
# Allowlist projects/README.md only (private-repo pointer index).
/projects/*
!/projects/README.md
*.pyc
__pycache__/
.pytest_cache/
*.egg-info/
dist/
build/
.cache/

# Runtime results (exports, audit logs) – recreated on run
digiquant/results/

# Repo-root runtime caches (Atlas price-history, agent-cache paths) — JAN-004
/data/

# Local agent memory archives (Cursor/agent tooling) — JAN-005
.remember/

# Local digikey dev SQLite (run_stack_local.sh) — JAN-006
.local_digikey.sqlite
/*.sqlite

# Olympus static portfolio fallback — stop tracking after REM-037 (JAN-007)
frontend/olympus/public/dashboard-data.json

# digithings-web OpenAPI explorer assets (copied at prebuild / predev from
# docs/openapi/ + swagger-ui-dist — never commit the vendored copies).
frontend/digithings-web/public/openapi/
frontend/digithings-web/public/swagger-ui/


# Secrets and credentials
.env*
projects/*/.env*
secrets.yaml
digikey/examples/vault.yaml

# Local stack (scripts/run_stack_local.sh)
.local_stack_pids
.litellm-local.log

# Log files
*.log

# Large data files and caches (CSV, Parquet, pickles)
# note: sample data in repo may be checked in intentionally, but user-owned
# datasets should not be
**/data/*.csv
**/data/*.parquet
**/data/*.pkl
**/data/*.pickle
**/data/*/*.csv
**/data/*/*.parquet
**/data/*/*.pkl
**/data/*/*.pickle

# Packaging output
digi-bundle-*.tar.gz
.DS_Store

# digigraph ECharts (installed in Docker / local npm ci; do not vendor node_modules)
digigraph/src/digigraph/tools/analytics/visualization/echarts/node_modules/

# digisearch EDGAR dev exports (generated; keep devdata/edgar_sample/.gitkeep)
digisearch/devdata/edgar_sample/edgar_*.md
digisearch/devdata/edgar_sample/edgar_*.yaml

# Local SQLite databases
*.sqlite

# Coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml

# macOS
.DS_Store
**/.DS_Store

# Editor / tooling
.vscode/
.idea/
*.bak

# DesignSync local tooling output (node_modules, bundles, screenshots, canvases — generated)
.ds-sync/
ds-bundle/
canvases/

# Strategy calibrations — proprietary tuning values
**/calibrations.json
# Strategy Pine files embed calibrated inputs (input.int(70, ...)) — keep private.
# The indicator library (pinescript/indicators/*.pine) is calibration-free and is
# committed as reusable fallback code.
**/pinescript/*.pine

# Private client projects live under root /projects/* (anchored above) — never
# add an unanchored `projects/` rule here, it would also capture docs/projects/,
# which ADR-0006 reserves for public, committed dogfood projects.

# playwright-mcp scratch output (page snapshots, console logs)
.playwright-mcp/

# digiclaw scheduler durable state (local)
.digiclaw/
