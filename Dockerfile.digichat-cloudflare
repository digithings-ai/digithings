# digichat image for digithings Cloudflare Containers.
# Build context: monorepo root (same as frontend/digichat/Dockerfile).
# DIGICHAT_ASSET_PREFIX avoids clashing with Pages `/_next` on digithings.ai.
# Embed CSP hosts come from runtime DIGICHAT_EMBED_HOSTS / DIGICHAT_EMBED_TENANTS
# (never bake DIGICHAT_EMBED_TENANTS as a build-arg — tokens in layer history).
ARG DIGICHAT_ASSET_PREFIX="/_dtchat"

FROM node:22-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
COPY frontend/digichat/package.json frontend/digichat/
COPY frontend/digichat-ui/package.json frontend/digichat-ui/
COPY frontend/digiweb/design/package.json frontend/digiweb/design/
COPY frontend/digiweb/web/package.json frontend/digiweb/web/
COPY frontend/dashboard/package.json frontend/dashboard/
RUN npm ci --workspace frontend/digichat --include-workspace-root

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG DIGICHAT_ASSET_PREFIX
ENV DIGICHAT_ASSET_PREFIX=$DIGICHAT_ASSET_PREFIX
ENV NEXT_PUBLIC_DIGICHAT_ASSET_PREFIX=$DIGICHAT_ASSET_PREFIX
COPY --from=deps /app ./
COPY frontend/digiweb/design ./frontend/digiweb/design
COPY frontend/digiweb/web ./frontend/digiweb/web
# Product skin @imports gallery chatbot.css from outside web/ (#3717).
COPY ["frontend/digiweb/reference/app/(chatbot)/chatbot/chatbot.css", "frontend/digiweb/reference/app/(chatbot)/chatbot/chatbot.css"]
COPY frontend/digichat-ui ./frontend/digichat-ui
COPY frontend/digichat ./frontend/digichat
# Alpine musl bindings for lockfile platforms that resolve to glibc on some hosts
RUN npm install \
      @rolldown/binding-linux-x64-musl@1.0.0-rc.16 \
      lightningcss-linux-x64-musl@1.32.0 \
      @tailwindcss/oxide-linux-x64-musl@4.2.2 \
      --no-save --no-audit --no-fund
# Bake DIGICHAT_VERSION from package.json so GET /api/health matches the package.
# Optional override: docker --build-arg or wrangler [[containers]] image_vars.
# Do not use a Cloudflare dashboard secret for this.
ARG DIGICHAT_VERSION
RUN VERSION="${DIGICHAT_VERSION:-$(node -p "require('./frontend/digichat/package.json').version")}" \
 && printf '%s' "$VERSION" > /tmp/digichat-version \
 && DIGICHAT_VERSION="$VERSION" npm run build --workspace frontend/digichat

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache curl
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/frontend/digichat/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/digichat/.next/static ./frontend/digichat/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/frontend/digichat/public ./frontend/digichat/public
COPY --from=builder --chown=nextjs:nodejs /app/frontend/digichat/scripts/trusted-proxy-server.mjs ./frontend/digichat/scripts/trusted-proxy-server.mjs
COPY --from=builder --chown=nextjs:nodejs /app/frontend/digichat/drizzle ./frontend/digichat/drizzle
COPY --from=builder /tmp/digichat-version /etc/digichat-version
# Empty when image_vars/--build-arg is omitted; trusted-proxy then reads /etc/digichat-version.
ARG DIGICHAT_VERSION
ENV DIGICHAT_VERSION=$DIGICHAT_VERSION
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "frontend/digichat/scripts/trusted-proxy-server.mjs"]
