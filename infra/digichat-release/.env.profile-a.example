# Profile A — digigraph-backed digichat
# Copy to .env.profile-a (same directory) and replace placeholders.
# Usage from repo root:
#   docker compose -f infra/digichat-release/compose.profile-a.yml \
#     --env-file infra/digichat-release/.env.profile-a up -d --build

DIGICHAT_VERSION=0.9.3

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://127.0.0.1:3005
AUTH_TRUST_HOST=true

DIGICHAT_POSTGRES_PASSWORD=digichat
DIGICHAT_AUTO_MIGRATE=1
DIGICHAT_EMBED_ENABLED=1
DIGICHAT_PUBLISH_HOST=127.0.0.1
DIGICHAT_PUBLISH_PORT=3005

# Runtime CSP frame-ancestors (stock GHCR — no rebuild). Optional if hosts already
# appear as DIGICHAT_EMBED_TENANTS keys and DIGICHAT_EMBED_HOSTS is unset.
# DIGICHAT_EMBED_HOSTS=example.com,www.example.com

# Runtime registry — NEVER pass as Docker build-arg (tokens leak in layers)
DIGICHAT_EMBED_TENANTS={"example.com":{"slug":"example","gateMode":"ungated","activityDetail":"full","layout":"page","token":"replace-me","backend":{"type":"digigraph"}}}

DIGIGRAPH_INTERNAL_URL=http://digigraph:8000
DIGIKEY_URL=http://digikey:8005
DIGIKEY_BFF_TOKEN=replace-me
DIGIKEY_ISSUER=http://digikey:8005
DIGIKEY_ALLOW_DEV_GLOBAL=0

# On digigraph / LiteLLM (same compose project)
DIGIVAULT_URL=http://digivault:8004
# Leave digiquant / digisearch unset — Profile A does not start those services
DIGIQUANT_URL=
DIGISEARCH_URL=
DIGISMITH_URL=

# Provider keys for LiteLLM / digillm — see root .env.example
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# LITELLM_MASTER_KEY=
# LITELLM_PROXY_API_KEY=
