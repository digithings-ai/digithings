# Profile A bundle — one digithings-stack image + digichat (+ Postgres)
# Copy to .env.profile-a-bundle and replace placeholders.
# Usage from repo root:
#   make digichat-profile-a-bundle-up
#
# Same backends as Cloudflare Containers (supervisord). Prefer this over
# `docker compose up` (N containers) when working on website digichat.

DIGICHAT_VERSION=1.0.0

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://127.0.0.1:3005
AUTH_TRUST_HOST=true

DIGICHAT_POSTGRES_PASSWORD=digichat
DIGICHAT_AUTO_MIGRATE=1
DIGICHAT_EMBED_ENABLED=1
DIGICHAT_REQUIRE_ROOT_AUTH=0
DIGICHAT_PUBLISH_HOST=127.0.0.1
DIGICHAT_PUBLISH_PORT=3005
DIGICHAT_ENABLED_SERVICES=digigraph

# Runtime registry — NEVER pass as Docker build-arg.
# OCC must keep digisearchIndex + vaultPathPrefix (digichat → X-Digi-Corpus-Index /
# X-Digi-Vault-Prefix). Use occ.digithings.ai as the virtual embed host for /chat/occ.
# Include loopback so frame-ancestors emits http://127.0.0.1:* / http://localhost:*
# (production NODE_ENV Docker still needs these for digithings-web on :3010).
DIGICHAT_EMBED_HOSTS=digithings.ai,www.digithings.ai,occ.digithings.ai,127.0.0.1,localhost
# Belt-and-suspenders when DIGICHAT_EMBED_HOSTS omits loopback (local Profile A).
DIGICHAT_ALLOW_LOCAL_EMBED_PARENTS=1
DIGICHAT_EMBED_TENANTS='{"digithings.ai":{"slug":"digithings","aliases":["www.digithings.ai","127.0.0.1","localhost"],"gateMode":"ungated","showByok":true,"showStatusBar":true,"layout":"page","llmAccess":"free_then_byok","activityDetail":"full","attribution":false,"token":"local-dev-unused-first-party","backend":{"type":"digigraph"}},"occ.digithings.ai":{"slug":"occ","gateMode":"ungated","showByok":true,"showStatusBar":true,"layout":"page","activityDetail":"full","title":"OCC help assistant","welcome":"Ask about Online Compliance Center policies, procedures, and help articles.","attribution":false,"token":"local-dev-unused-first-party","backend":{"type":"digigraph","digisearchIndex":"occ_help","vaultPathPrefix":"clients/online-compliance-center"}}}'

# digichat → stack service name on the compose network
DIGIGRAPH_INTERNAL_URL=http://digithings-stack:8000
DIGIKEY_URL=http://digithings-stack:8005
DIGIKEY_BFF_TOKEN=replace-me
# Issuer seen by browsers / JWKS consumers on the host
DIGIKEY_ISSUER=http://127.0.0.1:8005
DIGIKEY_ALLOW_EPHEMERAL_KEY=1
DIGIKEY_ALLOW_DEV_GLOBAL=0
# Optional stable RS256 PEM (multiline or base64). Empty → ephemeral for local.
# DIGIKEY_PRIVATE_KEY_PEM=

# Defense-in-depth on digigraph (headers from digichat still win).
DIGI_TENANT_CORPUS_MAP='{"occ":{"digisearchIndex":"occ_help","vaultPathPrefix":"clients/online-compliance-center"}}'


DIGI_LLM_MODE=test

# Chat-only digigraph (image defaults also set these in entrypoint)
# DIGI_PROJECT_CONFIG=/app/config/digiproject.yaml
# DIGI_WORKFLOW_PROFILE=research_rag
# DIGI_ALLOWED_TOOLS=digisearch,digivault_search_notes,digivault_get_note
# DIGIQUANT_URL=   # empty — no digiquant / no DIGIQUANT_DATA_DIR

# Provider keys for in-stack LiteLLM
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# LITELLM_PROXY_API_KEY=
