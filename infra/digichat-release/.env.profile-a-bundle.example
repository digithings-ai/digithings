# Profile A bundle — one digithings-stack image + digichat (+ Postgres)
# Copy to .env.profile-a-bundle and replace placeholders.
# Usage from repo root:
#   make digichat-profile-a-bundle-up
#
# Same backends as Cloudflare Containers (supervisord). Prefer this over
# `docker compose up` (N containers) when working on website digichat.

DIGICHAT_VERSION=1.0.0

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://127.0.0.1:3005
AUTH_TRUST_HOST=true

DIGICHAT_POSTGRES_PASSWORD=digichat
DIGICHAT_AUTO_MIGRATE=1
DIGICHAT_EMBED_ENABLED=1
DIGICHAT_REQUIRE_ROOT_AUTH=0
DIGICHAT_PUBLISH_HOST=127.0.0.1
DIGICHAT_PUBLISH_PORT=3005
DIGICHAT_ENABLED_SERVICES=digigraph

# Runtime registry — NEVER pass as Docker build-arg
DIGICHAT_EMBED_TENANTS={"example.com":{"slug":"example","gateMode":"ungated","activityDetail":"full","layout":"page","token":"replace-me","backend":{"type":"digigraph"}}}

# digichat → stack service name on the compose network
DIGIGRAPH_INTERNAL_URL=http://digithings-stack:8000
DIGIKEY_URL=http://digithings-stack:8005
DIGIKEY_BFF_TOKEN=replace-me
# Issuer seen by browsers / JWKS consumers on the host
DIGIKEY_ISSUER=http://127.0.0.1:8005
DIGIKEY_ALLOW_EPHEMERAL_KEY=1
DIGIKEY_ALLOW_DEV_GLOBAL=0
# Optional stable RS256 PEM (multiline or base64). Empty → ephemeral for local.
# DIGIKEY_PRIVATE_KEY_PEM=

DIGI_LLM_MODE=test

# Provider keys for in-stack LiteLLM
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# LITELLM_PROXY_API_KEY=
