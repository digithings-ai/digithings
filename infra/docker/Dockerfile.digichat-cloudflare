# digichat image for digithings Cloudflare Containers.
# Build context: monorepo root (same as apps/digichat/Dockerfile).
# DIGICHAT_ASSET_PREFIX avoids clashing with Pages `/_next` on digithings.ai.
# Embed CSP hosts come from runtime DIGICHAT_EMBED_HOSTS / DIGICHAT_EMBED_TENANTS
# (never bake DIGICHAT_EMBED_TENANTS as a build-arg — tokens in layer history).
#
# DIG-3701: @digithings/design, @digithings/ui and @digithings/digichat-ui are
# installed from tarballs produced by scripts/package_r5_image_inputs.py.
# The root lockfile still pins the rest. The only sibling tree copied is
# apps/digichat itself, plus config/byok-providers.json.
ARG DIGICHAT_ASSET_PREFIX="/_dtchat"
# DIG-5121: the app is served under /chat on digithings.ai (ADR 0018, GitHub
# #1252). Next bakes `basePath` at BUILD time, so this is a build arg and not a
# runtime env: the Worker routes digithings.ai/chat* here, and the app answers
# under /chat. The Worker maps every legacy path onto this base path
# (apps/digichat-cloudflare/src/paths.ts), and the contract test pins the two
# values together so the edge and the image cannot drift.
ARG DIGICHAT_BASE_PATH="/chat"

FROM node:22-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
COPY apps/digichat/package.json apps/digichat/
COPY image-packages/digichat/manifests/design/package.json packages/design/package.json
COPY image-packages/digichat/manifests/ui/package.json packages/ui/package.json
COPY image-packages/digichat/manifests/digichat-ui/package.json packages/digichat-ui/package.json
COPY image-packages/digichat/manifests/dashboard/package.json apps/dashboard/package.json
COPY image-packages/digichat/manifests/hero-banner/package.json packages/hero-banner/package.json
COPY image-packages/digichat/manifests/catalog/package.json packages/catalog/package.json
RUN npm ci --workspace apps/digichat --include-workspace-root

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG DIGICHAT_ASSET_PREFIX
ENV DIGICHAT_ASSET_PREFIX=$DIGICHAT_ASSET_PREFIX
ENV NEXT_PUBLIC_DIGICHAT_ASSET_PREFIX=$DIGICHAT_ASSET_PREFIX
# The app's base path (DIG-5121). DIGICHAT_BASE_PATH is read by
# apps/digichat/next.config.ts (the `basePath` Next bakes in) and
# NEXT_PUBLIC_DIGICHAT_BASE_PATH by apps/digichat/src/lib/base-path.ts (the
# prefix the client puts on its own routes). They MUST carry the same value:
# one is the server's base path, the other is the client's, and a mismatch
# shows up as links that 404 under the base path.
ARG DIGICHAT_BASE_PATH
ENV DIGICHAT_BASE_PATH=$DIGICHAT_BASE_PATH
ENV NEXT_PUBLIC_DIGICHAT_BASE_PATH=$DIGICHAT_BASE_PATH
COPY --from=deps /app ./
COPY image-packages/digichat/npm/ /tmp/digi-npm/
# Unpack the published package trees over the manifests npm ci linked.
# Grammar moved into the package (WS1): chat-digichat.css ships with
# packages/ui, so no gallery COPY is needed anymore (#3717 closed).
RUN tar -xzf /tmp/digi-npm/digithings-design-*.tgz -C packages/design --strip-components=1 \
 && tar -xzf /tmp/digi-npm/digithings-ui-*.tgz -C packages/ui --strip-components=1 \
 && tar -xzf /tmp/digi-npm/digithings-digichat-ui-*.tgz -C packages/digichat-ui --strip-components=1 \
 && tar -xzf /tmp/digi-npm/digithings-hero-banner-*.tgz -C packages/hero-banner --strip-components=1 \
 && tar -xzf /tmp/digi-npm/digithings-catalog-*.tgz -C packages/catalog --strip-components=1
COPY apps/digichat ./apps/digichat
COPY tsconfig.base.json ./tsconfig.base.json
# BYOK provider pins are imported from the repo-root config (#5020).
COPY config/byok-providers.json ./config/byok-providers.json
# Alpine musl bindings for lockfile platforms that resolve to glibc on some hosts.
# linux-x64-musl is the Cloudflare container arch. linux-arm64-musl is the same
# pins so a local arm64 docker build uses bindings that match the image.
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64) plat=linux-x64-musl ;; \
      aarch64) plat=linux-arm64-musl ;; \
      *) echo "unsupported musl arch $(uname -m)" >&2; exit 1 ;; \
    esac; \
    npm install \
      "@rolldown/binding-${plat}@1.0.0-rc.16" \
      "lightningcss-${plat}@1.32.0" \
      "@tailwindcss/oxide-${plat}@4.2.2" \
      --no-save --no-audit --no-fund
# Bake DIGICHAT_VERSION from package.json so GET /api/health matches the package.
# Optional override: docker --build-arg or wrangler [[containers]] image_vars.
# Do not use a Cloudflare dashboard secret for this.
ARG DIGICHAT_VERSION
RUN VERSION="${DIGICHAT_VERSION:-$(node -p "require('./apps/digichat/package.json').version")}" \
 && printf '%s' "$VERSION" > /tmp/digichat-version \
 && DIGICHAT_VERSION="$VERSION" npm run build --workspace apps/digichat

FROM node:22-alpine AS runner
WORKDIR /app
# D-R5-1. Account id is supplied by the operator at push time (H3).
ARG IMAGE_PUSH_REGISTRY=registry.cloudflare.com
ARG IMAGE_PUSH_REPOSITORY=digithings/digichat
LABEL org.digithings.image.registry="${IMAGE_PUSH_REGISTRY}" \
      org.digithings.image.repository="${IMAGE_PUSH_REPOSITORY}"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# zammad-mcp (read-only OCC helpdesk MCP) runs beside the Node process: the
# trusted proxy spawns `python3 -m scripts.zammad_mcp.server` and routes
# /api/mcp/zammad* to it. Same dep pin as scripts/zammad_mcp/Dockerfile.mcp.
RUN apk add --no-cache curl python3 py3-pip \
 && python3 -m pip install --no-cache-dir --break-system-packages "mcp>=1.26,<2" "httpx>=0.28,<1"
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/digichat/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/digichat/.next/static ./apps/digichat/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/digichat/public ./apps/digichat/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/digichat/scripts/trusted-proxy-server.mjs ./apps/digichat/scripts/trusted-proxy-server.mjs
COPY --chown=nextjs:nodejs scripts/zammad_mcp ./scripts/zammad_mcp
COPY --from=builder --chown=nextjs:nodejs /app/apps/digichat/drizzle ./apps/digichat/drizzle
COPY --from=builder /tmp/digichat-version /etc/digichat-version
# Empty when image_vars/--build-arg is omitted; trusted-proxy then reads /etc/digichat-version.
ARG DIGICHAT_VERSION
ENV DIGICHAT_VERSION=$DIGICHAT_VERSION
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# A running container keeps its start-time env until recycled. To roll a warm
# instance after a Worker secret change, bump SHARED_DIGICHAT_CONTAINER_ID
# (apps/digichat-cloudflare/src/paths.ts:22) and redeploy. A rebuild
# marker only changes the image tag, not the instance id.
CMD ["node", "apps/digichat/scripts/trusted-proxy-server.mjs"]
