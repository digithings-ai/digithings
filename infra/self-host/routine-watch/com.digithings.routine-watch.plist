<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.digithings.routine-watch -- copy of record for the Paperclip routine-firing
  observer (DIG-1220). Installed at ~/Library/LaunchAgents/com.digithings.routine-watch.plist
  and bootstrapped with `launchctl bootstrap gui/$(id -u)`.

  ProgramArguments points at the canonical copy in ~/paperclip-workspace/kit/bin/dt-routine-watch.
  That is the only copy: Paperclip is loopback-only, so the observer has to be host-resident, and
  the kit is where every other house clock lives. This repo used to carry a second copy of the
  observer as a review surface; it had already drifted from the running one, so it was removed
  (DIG-2618). Do not add it back -- see docs/ops/paperclip-routine-watch.md.
-->
<plist version="1.0"><dict>
<key>Label</key><string>com.digithings.routine-watch</string>
<key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>/Users/chrisstefan/paperclip-workspace/kit/bin/dt-routine-watch</string></array>
<key>StartInterval</key><integer>300</integer>
<key>RunAtLoad</key><false/>
<key>StandardOutPath</key><string>/Users/chrisstefan/.config/digithings/routine-watch.log</string>
<key>StandardErrorPath</key><string>/Users/chrisstefan/.config/digithings/routine-watch.log</string>
</dict></plist>