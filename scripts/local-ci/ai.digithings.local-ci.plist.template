<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>ai.digithings.local-ci</string>
<key>ProgramArguments</key><array><string>__PYTHON__</string><string>__CHECKOUT__/scripts/local-ci/local_ci.py</string></array>
<key>StartInterval</key><integer>180</integer>
<key>LowPriorityIO</key><true/><key>Nice</key><integer>10</integer>
<key>StandardOutPath</key><string>__HOME__/.config/digithings/logs/local-ci/launchd.out</string>
<key>StandardErrorPath</key><string>__HOME__/.config/digithings/logs/local-ci/launchd.err</string>
<key>EnvironmentVariables</key><dict>
<key>LOCAL_CI_MAIN</key><string>__CHECKOUT__</string>
<key>LOCAL_CI_WT</key><string>__HOME__/.config/digithings/state/local-ci-wt</string>
</dict>
</dict></plist>
