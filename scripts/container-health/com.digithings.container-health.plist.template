<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.digithings.container-health: the daily container health check (DIG-2910).

  It probes /healthz on graph.digithings.ai, key.digithings.ai and
  search.digithings.ai from Chris's Mac. /healthz never wakes the sleeping
  container (wake hygiene, apps/digithings-stack-cloudflare/src/wake-hygiene.ts), so
  the check costs nothing: it reads the container's own liveness payload when the
  container is awake and the worker's sleeping answer when it is not. The cron job
  smoke-stack keeps the worker-only probes (/_stack/status); this is the deep half
  that the cron cannot do.

  ProgramArguments reads the credential the same way com.digithings.it-watch does,
  and in the same spirit: a missing credential means the check still runs (it is
  read-only) but a failure cannot be filed as a ticket, so the job says so in the
  log instead of dying silently. A rotation deadline that has passed withholds the
  credential: rotating it is Security's call, not this job's.

  The file in this repository is the copy of record. Install it with
  scripts/container-health/install.sh. Loading a launchd job is Chris's call, so
  the installer writes the plist and leaves the load to an explicit load flag.
-->
<plist version="1.0"><dict>
<key>Label</key><string>com.digithings.container-health</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>-c</string><string>K=$(/usr/bin/security find-generic-password -s digithings -a paperclip-api-key-board -w 2>/dev/null); if [ -z "$K" ]; then echo "$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ) container-health: no credential in the login keychain (digithings/paperclip-api-key-board); continuing read-only. The check still runs, but a failure cannot be filed as a ticket."; else D=$(/usr/bin/security find-generic-password -s digithings -a paperclip-api-key-board-rotate-by -w 2>/dev/null); if [ -z "$D" ] || [ "$D" -le "$(/bin/date +%s)" ]; then echo "$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ) container-health: PAPERCLIP_API_KEY withheld, rotation deadline missing or passed. Rotating the credential is Security's call (DIG-780); continuing read-only."; K=; else export PAPERCLIP_API_KEY="$K"; fi; unset K D; fi; exec /usr/bin/python3 __CHECKOUT__/scripts/container-health/container_health.py</string></array>
<key>StartCalendarInterval</key><dict>
<key>Hour</key><integer>7</integer>
<key>Minute</key><integer>40</integer>
</dict>
<key>RunAtLoad</key><false/>
<key>ProcessType</key><string>Background</string>
<key>EnvironmentVariables</key><dict>
<key>PAPERCLIP_API_URL</key><string>http://localhost:3100/api</string>
</dict>
<key>StandardOutPath</key><string>__HOME__/.config/digithings/logs/container-health/launchd.out</string>
<key>StandardErrorPath</key><string>__HOME__/.config/digithings/logs/container-health/launchd.err</string>
</dict></plist>
