#!/usr/bin/env python3
"""The `gh-app-token` command: the box-side GitHub App token helper.

See `scripts/dt_broker/boxtoken.py` and docs/ops/dt-broker.md. The script finds
the package next to itself, so it works from a checkout or a worktree.
There is no default role: pass --role or set GH_APP_TOKEN_ROLE.
"""

from __future__ import annotations

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_ROOT = os.path.dirname(_HERE)
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from scripts.dt_broker.boxtoken import main  # noqa: E402  (the path is set above)

if __name__ == "__main__":
    raise SystemExit(main())
