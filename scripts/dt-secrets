#!/usr/bin/env python3
"""dt-secrets -- render the digithings local secret file from the secrets contract.

WHY THIS EXISTS
The self-hosted reference stack and the Cloudflare-hosted production stack must
use the SAME environment variable names. That shared set of names is a contract,
and it lives in `config/contract/secrets.yaml` (see docs/adr/0029-secrets-management.md).
Values are not part of the contract: a variant supplies its own. This tool turns
"which names does the selfhost variant need" into a gitignored `.dev.vars`.

WHAT IT DOES
`render` resolves every secret the selected variant requires and writes them to
`.dev.vars` with mode 0600. Resolution order per secret:

  keychain          macOS: `security find-generic-password -s digithings/<NAME> -w`
                    Linux/OSS: `pass show digithings/<NAME>`, then the 1Password CLI
                    (`op read op://digithings/<NAME>`), then an interactive prompt.
  generated-local   run the entry's `generate` argv, or render its `template`.
                    Never reads a production store: these values are minted here.
  operator-prompt   typed by the operator at render time.
  github-secret     NOT rendered. Lives in GitHub Actions; write-only from here.
  cloudflare-secret NOT rendered. Write-only via `wrangler secret put`.

Every store is reached by shelling out to its CLI. No vendor SDK is imported,
because ADR 0029 forbids shipping one inside digibase/digillm.

SAFETY RULES ENFORCED HERE
  1. Values are never printed. Every summary line names the SECRET, not its value.
  2. The output file is created 0600 and never exists world-readable, not even
     briefly: it is written to a 0600 temp file and atomically renamed.
  3. Render is all-or-nothing. A missing value aborts before anything is written,
     so a half-filled `.dev.vars` can never exist.
  4. This tool makes no network call. It resolves credentials from local stores
     only, so it cannot fetch a production value by accident.

USAGE
  dt-secrets list                      # names, variants, sources. No values.
  dt-secrets check                     # what is missing. Writes nothing.
  dt-secrets render [--variant selfhost]
  dt-secrets render --only NAME,NAME   # render a subset
  dt-secrets render --dry-run          # report what would be written. Writes nothing.
"""

from __future__ import annotations

import argparse
import getpass
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover - environment fault, not a logic branch
    sys.exit("dt-secrets needs PyYAML: pip install pyyaml")

DEFAULT_MANIFEST = Path("config/contract/secrets.yaml")
NAME_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")
PLACEHOLDER_RE = re.compile(r"__random_hex_(\d+)__")
# Field extraction for `generate` entries that emit KEY="value" lines.
KV_RE = re.compile(r'^([A-Z][A-Z0-9_]*)="(.*)"\s*$')


class RenderError(RuntimeError):
    """A secret could not be resolved. Carries the NAME, never the value."""


# ---------------------------------------------------------------- manifest


def load_manifest(path: Path) -> dict:
    if not path.is_file():
        raise RenderError(f"manifest not found: {path}")
    doc = yaml.safe_load(path.read_text())
    if not isinstance(doc, dict) or "secrets" not in doc:
        raise RenderError(f"manifest has no `secrets` list: {path}")
    return doc


def wanted(doc: dict, variant: str) -> list[dict]:
    """Entries the given variant requires, in manifest order."""
    return [e for e in doc["secrets"] if variant in e.get("required_in", [])]


def renderable(doc: dict, entry: dict) -> bool:
    """A secret is renderable when its source can produce a local value."""
    return bool(doc["sources"][entry["source"]]["renderable"])


# ------------------------------------------------------------- generation


def run_generate(argv: list[str], field: str | None) -> str:
    """Run a generate command and return the value it produced."""
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=30, check=False)
    except FileNotFoundError as exc:
        raise RenderError(f"{shlex.join(argv)} is not installed") from exc
    if proc.returncode != 0:
        # stderr is a tool message, never a secret value.
        raise RenderError(f"{shlex.join(argv)} exited {proc.returncode}")
    if field is None:
        value = proc.stdout.strip()
    else:
        value = ""
        for line in proc.stdout.splitlines():
            m = KV_RE.match(line.strip())
            if m and m.group(1) == field:
                value = m.group(2)
                break
        if not value:
            raise RenderError(f"{shlex.join(argv)} printed no {field}")
    if not value:
        raise RenderError(f"{shlex.join(argv)} produced an empty value")
    return value


def random_hex(nbytes: int) -> str:
    return os.urandom(nbytes).hex()[: nbytes * 2]


def render_template(template: str) -> str:
    """Substitute every __random_hex_N__ placeholder with N hex characters."""
    out, last = [], 0
    for m in PLACEHOLDER_RE.finditer(template):
        out.append(template[last : m.start()])
        out.append(os.urandom(int(m.group(1))).hex())
        last = m.end()
    out.append(template[last:])
    return "".join(out)


# --------------------------------------------------------------- keychain


def from_store(name: str, prefix: str, allow_prompt: bool) -> str | None:
    """Read one value from the operator's credential store. None if absent."""
    item = f"{prefix}{name}"

    if sys.platform == "darwin":
        try:
            proc = subprocess.run(
                ["security", "find-generic-password", "-s", item, "-w"],
                capture_output=True,
                text=True,
                timeout=15,
                check=False,
            )
        except FileNotFoundError:
            proc = None  # no keychain on this host; fall through to the other stores
        if proc is not None and proc.returncode == 0:
            value = proc.stdout.strip()
            if value:
                return value

    for argv in (["pass", "show", item], ["op", "read", f"op://{item}"]):
        if shutil_which(argv[0]) is None:
            continue
        try:
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=15, check=False)
        except (FileNotFoundError, OSError):
            continue
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.strip()

    if allow_prompt:
        return prompt(f"{name}: ")
    return None


def shutil_which(name: str) -> str | None:
    from shutil import which

    return which(name)


def prompt(label: str) -> str:
    """Ask for a value without echoing it."""
    try:
        value = getpass.getpass(label)
    except (EOFError, KeyboardInterrupt):
        raise RenderError("cancelled at the operator prompt") from None
    value = value.strip()
    if not value:
        raise RenderError("operator prompt returned an empty value")
    return value


# ------------------------------------------------------------- resolution


def resolve(doc: dict, entry: dict, values: dict[str, str], allow_prompt: bool) -> str | None:
    """Resolve one entry. Returns None when it is not renderable."""
    name = entry["name"]
    source = entry["source"]
    prefix = doc.get("contract", {}).get("keychain_service_prefix", "digithings/")

    if "same_as" in entry:
        target = entry["same_as"]
        if target in values:
            return values[target]
        return None

    if source == "generated-local":
        if "template" in entry:
            return render_template(entry["template"])
        return run_generate(entry["generate"], entry.get("generate_field"))

    if source == "keychain":
        return from_store(name, prefix, allow_prompt)

    if source == "operator-prompt":
        return prompt(f"{name}: ") if allow_prompt else None

    return None  # github-secret / cloudflare-secret: deliberately not renderable


# ------------------------------------------------------------------ output


def write_dev_vars(path: Path, values: dict[str, str]) -> None:
    """Write the rendered file 0600, atomically. Never world-readable."""
    body = "".join(f"{k}={v}\n" for k, v in values.items())
    directory = path.parent if str(path.parent) else Path(".")
    directory.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(directory), prefix=".dev.vars.", suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(body)
        os.replace(tmp, path)
        os.chmod(path, 0o600)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def report(name: str, how: str) -> str:
    """A progress line. Names the secret and its source; never the value."""
    return f"  {name:<32} {how}"


# -------------------------------------------------------------------- main


def resolve_all(
    doc: dict, entries: list[dict], allow_prompt: bool, verbose: bool
) -> tuple[dict[str, str], list[str], list[str]]:
    """Resolve every entry.

    Entries that alias another (`same_as`) are resolved last and retried, so the
    manifest's alphabetical order does not decide which one resolves first.
    """
    values: dict[str, str] = {}
    missing: list[str] = []
    skipped: list[str] = []

    def do(entry: dict) -> bool:
        """Resolve one entry. False when it could not be resolved yet."""
        name = entry["name"]
        if not NAME_RE.match(name):
            raise_render(f"manifest name is not a valid env var: {name!r}")
        if not renderable(doc, entry):
            skipped.append(name)
            return True
        try:
            value = resolve(doc, entry, values, allow_prompt)
        except RenderError as exc:
            raise_render(f"{name}: {exc}")
        if value is None:
            return False
        values[name] = value
        if verbose:
            print(report(name, entry["source"]))
        return True

    aliases = [e for e in entries if "same_as" in e]
    for entry in [e for e in entries if "same_as" not in e]:
        do(entry)

    pending = list(aliases)
    while pending:
        progressed = [e for e in pending if do(e)]
        if len(progressed) == len(pending):
            break  # nothing resolved this pass: the remaining ones are unresolvable
        pending = [e for e in pending if e not in progressed]

    missing = [e["name"] for e in entries if e["name"] not in values and e["name"] not in skipped]
    return values, missing, skipped


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="dt-secrets", description=__doc__.split("\n")[0])
    ap.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_list = sub.add_parser("list", help="list contract entries (no values)")
    p_list.add_argument("--variant", default=None)

    p_check = sub.add_parser("check", help="report missing secrets; write nothing")
    p_check.add_argument("--variant", default=None)
    p_check.add_argument("--only", default=None)

    p_render = sub.add_parser("render", help="render the secret file")
    p_render.add_argument("--variant", default=None)
    p_render.add_argument("--output", type=Path, default=None)
    p_render.add_argument("--only", default=None)
    p_render.add_argument("--dry-run", action="store_true")
    p_render.add_argument(
        "--no-prompt", action="store_true", help="fail instead of asking the operator"
    )
    p_render.add_argument("--force", action="store_true", help="overwrite an existing file")

    args = ap.parse_args(argv)

    try:
        doc = load_manifest(args.manifest)
    except RenderError as exc:
        print(f"dt-secrets: {exc}", file=sys.stderr)
        return 2

    default_variant = doc.get("contract", {}).get("default_variant", "selfhost")
    variant = args.variant or default_variant
    entries = wanted(doc, variant)
    only = getattr(args, "only", None)
    if only:
        keep = {n.strip() for n in only.split(",") if n.strip()}
        entries = [e for e in entries if e["name"] in keep]

    if args.cmd == "list":
        print(f"{variant}: {len(entries)} secret(s) required")
        for e in entries:
            flags = "".join(
                v[0].upper() for v in e["required_in"] if v in doc["contract"]["variants"]
            )
            print(f"  {e['name']:<32} {e['source']:<18} {flags}")
        return 0

    allow_prompt = args.cmd == "render" and not args.no_prompt
    values, missing, skipped = resolve_all(doc, entries, allow_prompt, args.cmd == "render")

    if args.cmd == "check":
        print(f"{len(values)} resolved, {len(missing)} missing, {len(skipped)} not renderable")
        for name in missing:
            print(f"  missing: {name}")
        return 1 if missing else 0

    if missing:
        print(
            f"dt-secrets: {len(missing)} value(s) unresolved; nothing written "
            "(render is all-or-nothing)",
            file=sys.stderr,
        )
        for name in missing:
            print(f"  missing: {name}", file=sys.stderr)
        return 1

    output = args.output or Path(doc.get("contract", {}).get("output", ".dev.vars"))
    if args.dry_run:
        print(f"dry-run: would write {len(values)} value(s) to {output} (mode 0600)")
        return 0

    if output.exists() and not args.force:
        print(f"dt-secrets: {output} exists; pass --force to overwrite", file=sys.stderr)
        return 1

    write_dev_vars(output, values)
    print(f"wrote {len(values)} value(s) to {output} (mode 0600)")
    if skipped:
        print(f"not rendered (no local value by design): {', '.join(skipped)}")
    return 0


def raise_render(message: str) -> None:
    print(f"dt-secrets: {message}", file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    raise SystemExit(main())
