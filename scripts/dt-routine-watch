#!/usr/bin/env python3
"""dt-routine-watch: observe whether a Paperclip routine on a schedule trigger actually fired.

The gap (DIG-1220): a schedule trigger fires, opens a run issue, an agent works it. If it does
NOT fire, nothing is written anywhere, so "the routine went silent" and "the routine ran and found
nothing" look identical from outside. `nextRunAt` is the scheduler's claim about the future, not an
observation of the past. Nothing read it.

What this does: it takes that claim and makes it falsifiable. Every tick it reads the boundary the
scheduler says is next (`triggers[].nextRunAt`). Once now is past the boundary plus a grace period,
it asks a different system whether the firing is visible: the routine's own run history
(`/routines/{id}/runs`) and the trigger's own `lastFiredAt` / `lastResult`. No run and no
lastFiredAt means the boundary passed and nothing fired. That gets filed.

Why this runs here and not in Cloudflare or GitHub Actions: Paperclip is loopback-only
(`server.bind: loopback`, `server.exposure: private`, 127.0.0.1:3100), so no off-host clock can
read the routines API at all. launchd is also an independent scheduler from Paperclip's own, which
is the whole point: a sibling Paperclip routine would share the failure domain it is meant to watch.

Evidence test, and why it is strict: a run only counts as evidence of the schedule firing when
`triggerId` equals the watched trigger, or `source == "schedule"`. Manual probes have
`triggerId: null` and `source: "manual"`, so they cannot be mistaken for a firing. Treating a manual
probe as proof is exactly the false negative this exists to prevent.

The same pattern as .github/workflows/feed_confirm_watchdog.yml (twelve-x PR #291), which asks
another system's run history rather than writing its own heartbeat stamp: a stamp we write is only
as reliable as the thing writing it. So this files on absence AND on its own lookup failing, and it
is silent only when a run exists inside the window.

Credential note (read this before "fixing" it): this daemon sends no Authorization header, because
Paperclip mints no durable agent credential for a non-interactive process - agent JWTs are
run-scoped and expire, and POST /api/board-api-keys is account-level, which is Chris-only. Unused,
an authenticated write is filed as `authorType: user` / `local-board`, which is exactly the
misattribution the operating rules forbid. So every issue this files says in its body which agent
installed it and on which issue. Tracked as a real gap for Security/IT, not papered over.

Usage: dt-routine-watch [--dry] [--fixtures DIR] [--config PATH] [--state PATH]
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
CONF = HOME / ".config" / "digithings" / "routine-watch.json"
STATE = HOME / ".config" / "digithings" / "routine-watch-state.json"

# A boundary is judged only after this much slack, so a firing that is a few minutes late is not
# paged. 20 minutes against a daily 09:00Z boundary; the hourly watches have 20 windows of slack.
GRACE_DEFAULT = 1200

# Two of these in a row pages about the watchdog itself. Both are "did the clock actually run",
# which is the one thing this process cannot see from inside its own run.
SELF_GAP_DEFAULT = 3600
API_GAP_DEFAULT = 3600

# A firing the scheduler recorded but that produced no run is a coalesce (concurrencyPolicy
# coalesce_if_active) or a skipped window (catchUpPolicy skip_missed). One of those is normal; a
# streak means the routine stopped producing work even though the clock still turns.
SKIP_STREAK_DEFAULT = 3

# Runs that started within this many seconds before the boundary still count as the boundary's
# firing, so scheduler jitter does not read as silence.
EPSILON = 120


def now() -> datetime:
    return datetime.now(timezone.utc)


def iso(t: datetime) -> str:
    return t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")


def parse(ts) -> datetime | None:
    if not ts:
        return None
    try:
        return datetime.fromisoformat(str(ts).replace("Z", "+00:00")).astimezone(timezone.utc)
    except ValueError:
        return None


class Api:
    """Reads the Paperclip routines API on loopback.

    `fixtures` replaces the network with a directory of JSON files so the decision logic can be
    tested without a live board (see tests/dt-routine-watch-test.sh).
    """

    def __init__(self, base: str, fixtures: Path | None = None):
        self.base = base.rstrip("/")
        self.fixtures = fixtures
        self.calls: list[str] = []

    def get(self, path: str):
        self.calls.append("GET " + path)
        if self.fixtures:
            return self._fixture(path)
        req = urllib.request.Request(
            self.base + path, headers={"content-type": "application/json"}, method="GET"
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read()
            return json.loads(body) if body else {}

    def post(self, path: str, body: dict):
        self.calls.append("POST " + path)
        if self.fixtures:
            return {"fixture": True, "path": path, "body": body}
        data = json.dumps(body).encode()
        req = urllib.request.Request(
            self.base + path, data=data, headers={"content-type": "application/json"}, method="POST"
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}

    def _fixture(self, path: str):
        name = path.strip("/").replace("/", "_") + ".json"
        f = self.fixtures / name
        if not f.exists():
            raise FileNotFoundError("no fixture for %s (%s)" % (path, f))
        return json.loads(f.read_text())


def routine_by_id(routines, rid: str):
    for r in routines if isinstance(routines, list) else routines.get("routines", []):
        if r.get("id") == rid:
            return r
    return None


def trigger_by_id(routine, tid: str | None):
    for t in routine.get("triggers") or []:
        if tid is None or t.get("id") == tid:
            return t
    return None


def derive_watches(cfg: dict, routines) -> list[dict]:
    """Every active routine carrying an enabled schedule trigger, read from the board itself.

    Building the watch list from the company routines endpoint instead of hardcoding ids means a
    routine created tomorrow is watched tomorrow. A hardcoded list goes stale quietly, which is the
    same failure this tool exists to catch, one level up.

    Excluded on purpose: a paused routine (not expected to fire, so paging it would be noise), a
    disabled or archived trigger, and any trigger with no `nextRunAt` (nothing is claimed to be
    next, so there is no claim to falsify).
    """
    out = []
    for r in routines if isinstance(routines, list) else routines.get("routines", []):
        if r.get("status") != "active":
            continue
        for t in r.get("triggers") or []:
            if t.get("kind") != "schedule" or t.get("enabled") is False or t.get("archived"):
                continue
            if not t.get("nextRunAt"):
                continue
            out.append(
                {
                    "routineId": r.get("id"),
                    "triggerId": t.get("id"),
                    "ownerAgentId": r.get("assigneeAgentId") or cfg.get("defaultOwnerAgentId"),
                    "note": r.get("name") or r.get("title") or r.get("id"),
                }
            )
    return out


def schedule_run_at_or_after(runs, boundary: datetime, tid: str | None) -> dict | None:
    """The earliest run that can only have come from the schedule trigger at `boundary`.

    Deliberately strict: `triggerId` matching the watched trigger, or `source == "schedule"`.
    A manual run has neither and is not evidence, however recent it is.
    """
    hit = None
    for r in runs if isinstance(runs, list) else runs.get("runs", []):
        t = parse(r.get("triggeredAt"))
        if not t or t < boundary - timedelta(seconds=EPSILON):
            continue
        is_sched = r.get("source") == "schedule"
        matches_tid = tid is not None and r.get("triggerId") == tid
        if is_sched or matches_tid:
            if hit is None or t < parse(hit.get("triggeredAt")):
                hit = r
    return hit


def verdict(trigger: dict, runs, tid: str | None, boundary: datetime):
    """Classify one boundary. Returns (state, evidence-dict).

    ok      - a schedule run exists at or after the boundary
    coalesce- the scheduler recorded a firing (lastFiredAt) but no run came out of it; the
              scheduler's own lastResult says why. A record, not silence.
    missed  - no run and no lastFiredAt: the boundary passed and nothing fired anywhere
    """
    run = schedule_run_at_or_after(runs, boundary, tid)
    if run:
        return "ok", {
            "runId": run.get("id"),
            "triggeredAt": run.get("triggeredAt"),
            "source": run.get("source"),
            "status": run.get("status"),
            "linkedIssue": (run.get("linkedIssue") or {}).get("identifier"),
        }
    fired = parse(trigger.get("lastFiredAt"))
    if fired and fired >= boundary - timedelta(seconds=EPSILON):
        return "coalesce", {
            "lastFiredAt": trigger.get("lastFiredAt"),
            "lastResult": trigger.get("lastResult"),
        }
    return "missed", {
        "boundary": iso(boundary),
        "lastFiredAt": trigger.get("lastFiredAt"),
        "lastResult": trigger.get("lastResult"),
        "runsChecked": len(runs if isinstance(runs, list) else runs.get("runs", [])),
        "newestRunAt": max(
            [r.get("triggeredAt") or "" for r in (runs if isinstance(runs, list) else runs.get("runs", []))] or [None]
        ),
    }


def load(path: Path, default):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default
    except Exception as e:  # a broken state file must not silence the watchdog
        sys.stderr.write("dt-routine-watch: unreadable %s: %s\n" % (path, e))
        return default


def save(path: Path, st: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=1, sort_keys=True) + "\n")
    os.replace(tmp, path)


def file_issue(api: Api, cfg: dict, watch: dict, kind: str, title: str, body_lines: list[str], dry: bool):
    """File the page. Per standing.md the alarm path is a board issue, not mail or chat."""
    lines = list(body_lines)
    lines += [
        "",
        "---",
        "Filed by `dt-routine-watch`, a launchd clock on this host (com.digithings.routine-watch), "
        "installed by agent Platform `d80f78b8-9685-48c6-b9d2-665ecdffa6d3` on DIG-1220. It sends no "
        "Authorization header because Paperclip issues no durable agent credential to a "
        "non-interactive process, so this record is filed as local-board; read the filer, not the "
        "author field.",
        "Evidence is read from GET /api/routines/{id}/runs and the routine's own trigger fields. "
        "Kind: %s." % kind,
    ]
    payload = {
        "title": title,
        "body": "\n".join(lines),
        "priority": "high" if kind in ("missed", "self-gap") else "medium",
        "companyId": cfg["companyId"],
        "parentId": cfg.get("parentIssueId"),
        "goalId": cfg.get("goalId"),
        "assigneeAgentId": watch.get("ownerAgentId") or cfg.get("defaultOwnerAgentId"),
    }
    payload = {k: v for k, v in payload.items() if v}
    if dry:
        # Name the kind in the log line itself: a log that only shows the truncated body cannot say
        # afterwards which kind of page would have been filed.
        print("  DRY POST /api/issues kind=%s %s" % (kind, json.dumps(payload)[:400]))
        return None
    try:
        return api.post("/issues", payload)
    except urllib.error.HTTPError as e:
        # Never swallow: an alarm that cannot be filed is itself an alarm.
        sys.stderr.write(
            "dt-routine-watch: FILING FAILED for %r HTTP %s %s\n"
            % (title, e.code, e.read()[:200].decode(errors="replace"))
        )
    except Exception as e:
        sys.stderr.write("dt-routine-watch: FILING FAILED for %r: %s\n" % (title, e))
    return None


def main(argv: list[str]) -> int:
    args = argv[1:]
    dry = "--dry" in args
    fixtures = None
    if "--fixtures" in args:
        fixtures = Path(args[args.index("--fixtures") + 1])
    conf_path = Path(args[args.index("--config") + 1]) if "--config" in args else CONF
    state_path = Path(args[args.index("--state") + 1]) if "--state" in args else STATE

    cfg = load(conf_path, {})
    # An empty watch list is a loud failure, not a silent pass. `watchAllScheduleTriggers` is
    # accepted here as a watch list because it derives one from the board; it is resolved below,
    # after the routines read that it depends on.
    if not cfg.get("watch") and not cfg.get("watchAllScheduleTriggers"):
        sys.stderr.write("dt-routine-watch: no watch list in %s\n" % conf_path)
        return 1

    grace = int(cfg.get("graceSeconds", GRACE_DEFAULT))
    self_gap = int(cfg.get("maxSelfGapSeconds", SELF_GAP_DEFAULT))
    api_gap = int(cfg.get("maxApiGapSeconds", API_GAP_DEFAULT))
    skip_streak = int(cfg.get("skipStreakBeforeFiling", SKIP_STREAK_DEFAULT))

    st = load(state_path, {"boundaries": {}, "apiFailures": 0})
    st.setdefault("boundaries", {})
    st.setdefault("apiFailures", 0)
    st.setdefault("lastApiOkAt", None)
    api = Api(cfg.get("api", "http://127.0.0.1:3100/api"), fixtures)
    t0 = now()

    # 1. Our own two silences. A clock that stops turning must say so rather than quietly resume.
    last_check = parse(st.get("lastCheckAt"))
    if last_check and (t0 - last_check).total_seconds() > self_gap and not st.get("selfGapReportedAt"):
        hrs = round((t0 - last_check).total_seconds() / 3600, 1)
        print("SELF-GAP: last successful check was %.1fh ago" % hrs)
        file_issue(
            api, cfg, {}, "self-gap",
            "routine-watch did not run for %.1fh" % hrs,
            [
                "`dt-routine-watch` last completed a check at %s and is running now at %s, a gap of "
                "%.1fh. It did not run in between: the usual causes are this host asleep or off, or "
                "launchd not loaded. Nothing about any watched routine could be observed in that "
                "window, so treat the boundary checks after it as a gap, not as a clean result."
                % (st.get("lastCheckAt"), iso(t0), hrs),
                "",
                "This clock cannot see its own absence. Only a clock off this host could, and no "
                "off-host clock can read the loopback-only Paperclip API. That limit is real and "
                "unclosed.",
            ],
            dry,
        )
        st["selfGapReportedAt"] = iso(t0)

    # 2. Our own lookup failing is not swallowed either; it is reported once the API is back,
    #    because filing an issue is itself an API call.
    try:
        routines = api.get("/companies/%s/routines" % cfg["companyId"])
        st["apiFailures"] = 0
        st["apiDownSince"] = None
        if st.get("apiGapReportedAt"):
            file_issue(
                api, cfg, {}, "api-gap",
                "routine-watch could not read the routines API for %s" % st.get("apiGapReportedAt"),
                [
                    "`dt-routine-watch` recorded at least one failed read of the Paperclip routines "
                    "API and recovered at %s. During that window no boundary could be judged. The "
                    "watchdog pages on its own lookup failing because a lookup that silently fails "
                    "is indistinguishable from a routine that silently did not fire."
                    % iso(t0),
                ],
                dry,
            )
            st["apiGapReportedAt"] = None
    except Exception as e:
        st["apiFailures"] = int(st.get("apiFailures", 0)) + 1
        st["lastCheckAt"] = iso(t0)
        # Measured in elapsed wall-clock time, not in ticks: a tick count silently changes meaning
        # if anyone edits the launchd interval, and this threshold is about how long the API has
        # been unreadable, not how often we noticed.
        # If no successful check is on record there is no baseline to measure from, so the outage
        # starts at the first failure we saw rather than never being reportable.
        if not st.get("lastApiOkAt"):
            st["apiDownSince"] = st.get("apiDownSince") or iso(t0)
        since = parse(st.get("lastApiOkAt")) or parse(st.get("apiDownSince")) or t0
        down_for = (t0 - since).total_seconds()
        if down_for >= api_gap:
            st["apiGapReportedAt"] = st.get("apiGapReportedAt") or iso(t0)
        save(state_path, st)
        sys.stderr.write("dt-routine-watch: routines read failed (%s): %s\n" % (st["apiFailures"], e))
        print("read failed (%d in a row): %s" % (st["apiFailures"], e))
        return 0

    # 3. The watch list: explicit entries, plus every scheduled trigger on the board when asked.
    watches = list(cfg.get("watch") or [])
    if cfg.get("watchAllScheduleTriggers"):
        seen = {(w.get("routineId"), w.get("triggerId")) for w in watches}
        derived = derive_watches(cfg, routines)
        for w in derived:
            key = (w.get("routineId"), w.get("triggerId"))
            if key in seen:
                continue  # an explicit entry wins: it can carry a better note or owner
            watches.append(w)
            seen.add(key)
        print(
            "watching %d routine(s): %d configured, %d derived from the board"
            % (len(watches), len(cfg.get("watch") or []), len(derived))
        )
    if not watches:
        sys.stderr.write("dt-routine-watch: watchAllScheduleTriggers matched nothing\n")
        return 1

    # 4. Each watched boundary.
    for w in watches:
        rid = w["routineId"]
        tid = w.get("triggerId")
        routine = routine_by_id(routines, rid)
        if not routine:
            print("%s: routine not found in company list" % rid)
            continue
        trigger = trigger_by_id(routine, tid)
        if not trigger:
            print("%s: trigger %s not found" % (rid, tid))
            continue
        if trigger.get("archived") or trigger.get("enabled") is False:
            continue
        boundary = parse(trigger.get("nextRunAt"))
        if not boundary:
            print("%s: no nextRunAt, nothing claimed" % rid)
            continue
        if (t0 - boundary).total_seconds() <= grace:
            print(
                "%s: boundary %s not yet due, judged from %s"
                % (rid, trigger["nextRunAt"], iso(boundary + timedelta(seconds=grace)))
            )
            continue

        key = iso(boundary)
        rec = st["boundaries"].setdefault(rid, {"judged": [], "skipStreak": 0})
        if key in rec.get("judged", []):
            continue  # already judged; do not re-page on the same boundary

        try:
            runs = api.get("/routines/%s/runs" % rid)
        except Exception as e:
            sys.stderr.write("dt-routine-watch: runs read failed for %s: %s\n" % (rid, e))
            continue  # not judged, so not recorded: the next tick tries again

        state, ev = verdict(trigger, runs, tid, boundary)
        rec.setdefault("judged", []).append(key)
        rec["lastVerdict"] = state
        rec["lastEvidence"] = ev
        print("%s: boundary %s -> %s %s" % (rid, key, state, json.dumps(ev)))

        name = w.get("note") or routine.get("name") or routine.get("title") or rid
        if state == "missed":
            rec["skipStreak"] = 0
            file_issue(
                api, cfg, w, "missed",
                "routine did not fire: %s" % name,
                [
                    "A schedule boundary passed with no firing recorded anywhere. The scheduler's "
                    "own claim was `%s`; nothing corroborates it." % trigger.get("nextRunAt"),
                    "",
                    "- boundary: `%s` (grace %ds already elapsed)" % (key, grace),
                    "- trigger `lastFiredAt`: %s" % (trigger.get("lastFiredAt") or "null"),
                    "- trigger `lastResult`: %s" % (trigger.get("lastResult") or "null"),
                    "- schedule runs at or after the boundary: 0",
                    "- runs in history: %s (newest %s)"
                    % (ev.get("runsChecked"), ev.get("newestRunAt")),
                    "",
                    "Manual runs are excluded on purpose: a run counts only when its `triggerId` is "
                    "`%s` or its `source` is `schedule`. This is DIG-1220, watching routine `%s`." % (tid, rid),
                ],
                dry,
            )
        elif state == "coalesce":
            rec["skipStreak"] = int(rec.get("skipStreak", 0)) + 1
            print("  coalesce streak %d/%d" % (rec["skipStreak"], skip_streak))
            if rec["skipStreak"] >= skip_streak:
                file_issue(
                    api, cfg, w, "coalesced",
                    "routine fired %d boundaries in a row without producing a run: %s"
                    % (rec["skipStreak"], name),
                    [
                        "The clock turns but the routine produces no work. Each of the last %d "
                        "boundaries was recorded as fired with no run out of it, which is a "
                        "coalesce or a skipped window." % rec["skipStreak"],
                        "",
                        "- newest firing: `%s`" % ev.get("lastFiredAt"),
                        "- scheduler's own reason: `%s`" % ev.get("lastResult"),
                        "- routine `concurrencyPolicy` / `catchUpPolicy`: %s / %s"
                        % (routine.get("concurrencyPolicy"), routine.get("catchUpPolicy")),
                        "",
                        "One boundary like this is normal under `coalesce_if_active`. A streak is "
                        "not: the routine is running and achieving nothing, which is the same "
                        "silent outcome this watchdog exists to make visible.",
                    ],
                    dry,
                )
                rec["skipStreak"] = 0
        else:
            rec["skipStreak"] = 0

    st["lastCheckAt"] = iso(t0)
    st["lastApiOkAt"] = iso(t0)
    st["calls"] = api.calls
    save(state_path, st)
    print("checked %d watch(es) at %s%s" % (len(watches), iso(t0), " (dry)" if dry else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))