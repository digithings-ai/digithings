    {
      "id": "claim_ef50bea80c7645d7932d8605c53a4783",
      "statement": "The MCP_EDGE_KEY worker secret gates POST /mcp access: the `x-digi-mcp-key` request header must match the secret. When the secret is unset, the header is missing, or the values mismatch, `mcpAuthorized()` returns false and the worker responds with a plain 401 (no contract envelope).",
      "evidence": [
        {
          "resource": "repo://apps/dashboard-api/src/mcp.ts#L121-L126",
          "version": "repo-lines-v1:sha256:619fb068551cc7c1e983fe2a719e6ef0a2254b2d303d6f6cb382343241f2370d:"
