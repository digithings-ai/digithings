    {
      "id": "claim_f55f5df40edc419fa33454f670f2ea53",
      "statement": "The dashboard-api development commands are defined in apps/dashboard-api/package.json: `npm run dev` invokes `wrangler dev`, `npm run test` invokes `vitest run`, `npm run typecheck` invokes `tsc --noEmit`, and `npm run deploy` invokes `wrangler deploy`.",
      "evidence": [
        {
          "resource": "repo://apps/dashboard-api/package.json#L5-L9",
          "version": "repo-lines-v1:sha256:6c86a0b933266f37f67a2e19701f53678c8548d2056616c9c9421bba67b8d28a:"
        }
      ]
    },
    {
      "id": "claim_9f1fb087c47a4b9ab259b0b55f54f454",
      "statement": "SUPABASE_SERVICE_ROLE_KEY must live ONLY in Cloudflare Worker secrets (set via `wrangler secret put` or the CI deploy workflow's secrets input). It must never appear in wrangler.toml [vars], any static bundle, or any NEXT_PUBLIC_-prefixed environment variable.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy-dashboard-api.yml#L49-L52",
