{
  "components": {
    "schemas": {
      "TraceStatus": {
        "description": "Public status for GET /v1/status.",
        "properties": {
          "export_backend": {
            "default": "none",
            "description": "One of otel|none",
            "title": "Export Backend",
            "type": "string"
          },
          "otel_export_configured": {
            "default": false,
            "description": "An OTLP endpoint env var is set (OTel export leg active)",
            "title": "Otel Export Configured",
            "type": "boolean"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "X-Request-ID of the call that produced this status (echoed for correlation)",
            "title": "Request Id"
          },
          "tracing_configured": {
            "description": "An OTLP endpoint is set, so spans would be exported",
            "title": "Tracing Configured",
            "type": "boolean"
          },
          "version": {
            "description": "digitrace package version",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "tracing_configured"
        ],
        "title": "TraceStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Backend-neutral observability control plane for digithings. HTTP surface is intentionally thin (health + secret-free status). Interactive docs: `/docs` (Swagger) and `/redoc`.",
    "title": "digitrace",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Legacy health check (kept for back-compat).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Legacy health check",
        "tags": [
          "health"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Minimal liveness probe. Auth-exempt, secret-free.\n\nReturns HTTP 200 with ``{\"ok\": true}``. For richer diagnostics (tracing\nconfiguration, OTLP export state), see ``/v1/status``.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "status_v1_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Tracing status",
        "tags": [
          "status"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness probes.",
      "name": "health"
    },
    {
      "description": "Non-sensitive tracing configuration status.",
      "name": "status"
    }
  ]
}
