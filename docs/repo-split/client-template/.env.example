# Variable NAMES only, no values. Copy to .env (gitignored) and fill each value
# from your own keychain. Never commit .env. Referenced by AGENTS.md section 4,
# README.md, scripts/env.sh, compose/ and tenant/env/*.yaml.

# Local R0 checkout (scripts/env.sh; `make link` overrides it via .link)
DIGITHINGS_DIR=

# Pinned images for `make up` (compose/docker-compose.yml), taken from digithings.lock
DIGICHAT_IMAGE=
STACK_IMAGE=

# Free model ids for `make qa` (tests/run_qa.sh), comma-separated; paid models are not allowed
QA_MODELS=

# Secret names from tenant/env/*.yaml (secrets.embedToken, secrets.inviteKey)
EXAMPLE_EMBED_TOKEN=
EXAMPLE_INVITE_KEY=
