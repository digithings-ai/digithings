# GENERATED by config/contract/generate.py from config/contract/contract.yaml.
# Do not edit by hand; edit the contract and re-run the generator.
# Contract-derived skeleton. The hand-curated root .env.example stays authoritative
# for prose; check_contract.py proves every live assignment there maps here.

# --- docker compose ----------------------------------------------
# DigiChat session-signing secret. Never printed; rotate invalidates every session.
AUTH_SECRET=
# Trust the Host header for DigiChat URL building.
AUTH_TRUST_HOST=false
# DigiChat public auth origin.
AUTH_URL=
# Chrome skin used by digichat-dev.
DIGICHAT_CHROME_SKIN=
# Path to the digichat config document.
DIGICHAT_CONFIG_PATH=/app/config/digichat.yaml
# digichat-db Postgres password.
DIGICHAT_POSTGRES_PASSWORD=
# Host interface digichat's published port binds to.
DIGICHAT_PUBLISH_HOST=127.0.0.1
# Host port for digichat (3005 by default; the container listens on 3000).
DIGICHAT_PUBLISH_PORT=3005
# Long-lived API key the digiclaw heartbeat agent uses.
DIGICLAW_DIGIKEY_API_KEY=
# digigraph's credential for its own upstream LLM.
DIGIGRAPH_UPSTREAM_API_KEY=
# Optional digikey admin token for key management calls.
DIGIKEY_ADMIN_TOKEN=
# Server-to-server token DigiChat uses to call digikey.
DIGIKEY_BFF_TOKEN=
# Redis holding the JWT revocation blocklist.
DIGIKEY_BLOCKLIST_REDIS_URL=redis://digikey-blocklist-redis:6379/0
# digikey Postgres DSN. Required in the stack Worker; a sqlite path is the local default.
DIGIKEY_DATABASE_URL=
# JWKS endpoint every protected service fetches to verify JWTs.
DIGIKEY_JWKS_URL=http://digikey:8005/.well-known/jwks.json
# digikey's key into LiteLLM; falls back to LITELLM_MASTER_KEY.
DIGIKEY_LITELLM_PROXY_KEY=
# Pinned digikey public key, used when JWKS is unreachable.
DIGIKEY_PUBLIC_KEY_PEM=
# `1` refuses token issuance when the blocklist is unreachable (production default).
DIGIKEY_REQUIRE_BLOCKLIST=1
# Base URL clients use to reach digikey.
DIGIKEY_URL=http://digikey:8005
# SearxNG endpoint digisearch calls for web search.
DIGISEARCH_SEARXNG_URL=http://searxng:8080
# Exposes debug endpoints.
DIGI_ENABLE_DEBUG_ENDPOINTS=0
# Exposes the thread API.
DIGI_ENABLE_THREAD_API=0
# OTLP endpoint services export spans to.
DIGI_OTEL_ENDPOINT=
# Path to the project config document.
DIGI_PROJECT_CONFIG=/app/config/dogfood-digiproject.yaml
# Grafana admin password.
GRAFANA_ADMIN_PASSWORD=
# Grafana admin user.
GRAFANA_ADMIN_USER=admin
# LiteLLM master key. An empty value makes litellm exit 3.
LITELLM_MASTER_KEY=
# Credential services present to LiteLLM as a proxy.
LITELLM_PROXY_API_KEY=
# Omniroute credential.
OMNIROUTE_API_KEY=
# Omniroute auth-guard password.
OMNIROUTE_AUTH_PASSWORD=
# Standard OTLP exporter endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Zammad desk base URL for the read-only ticketing MCP.
ZAMMAD_BASE_URL=https://ticket.sitaas.de

# --- documented only ---------------------------------------------
# Where the audit log is written.
AUDIT_LOG_PATH=
# Directory holding digiclaw agent definitions.
DIGICLAW_AGENTS_DIR=
# File holding the digiclaw scheduler cursor.
DIGICLAW_SCHEDULER_STATE=
# digigraph base URL as set inside compose.
DIGIGRAPH_URL=
# digiquant data directory inside the container.
DIGIQUANT_DATA_DIR=
# Path to the digi config document.
DIGI_CONFIG_PATH=
# Workspace root for digiclaw.
DIGI_WORKSPACE=
# Directory exports are written to.
EXPORT_OUTPUT_DIR=
# Grafana usage reporting toggle.
GF_ANALYTICS_REPORTING_ENABLED=
# Grafana self sign-up toggle.
GF_USERS_ALLOW_SIGN_UP=
# Node runtime mode.
NODE_ENV=
# Port a service listens on, set literally in compose.
PORT=
# Unbuffered Python stdout.
PYTHONUNBUFFERED=
# Hosts the Zammad MCP will proxy to.
ZAMMAD_MCP_ALLOWED_HOSTS=
# Bind address for the Zammad MCP.
ZAMMAD_MCP_HOST=

# --- local dev env.example ---------------------------------------
# OIDC client id for DigiChat SSO.
AUTH_OIDC_CLIENT_ID=
# OIDC client secret for DigiChat SSO.
AUTH_OIDC_CLIENT_SECRET=
# OIDC issuer for DigiChat SSO.
AUTH_OIDC_ISSUER=
# Canonical Cloudflare account id for both Vectorize and D1.
CLOUDFLARE_ACCOUNT_ID=
# Credential for the Cloudflare transactional email API.
CLOUDFLARE_EMAIL_API_TOKEN=
# `1` runs digichat migrations at boot.
DIGICHAT_AUTO_MIGRATE=
# API key minted for the bootstrap tenant.
DIGICHAT_BOOTSTRAP_API_KEY=
# Tenant created at first boot.
DIGICHAT_BOOTSTRAP_TENANT_SLUG=
# digichat Postgres DSN. Deliberately unset in the DB-less Cloudflare deployment.
DIGICHAT_DATABASE_URL=
# Tenant used when a request carries none.
DIGICHAT_DEFAULT_TENANT_SLUG=
# Enables the local dev auth bypass.
DIGICHAT_DEV_AUTH=
# Password for the local dev auth bypass.
DIGICHAT_DEV_PASSWORD=
# Default model slug for digichat replies.
DIGICHAT_MODEL=
# Emit OpenWebUI-compatible message envelopes.
DIGICHAT_OPENWEBUI_FORMAT=
# Render the trace panel in digichat.
DIGICHAT_TRACE_UI=
# Host the digigraph dev server binds to.
DIGIGRAPH_HOST=
# digigraph base URL as called by digichat.
DIGIGRAPH_INTERNAL_URL=
# Port the digigraph dev server binds to.
DIGIGRAPH_PORT=
# Host the digiquant dev server binds to.
DIGIQUANT_HOST=
# digiquant base URL as called by digichat.
DIGIQUANT_INTERNAL_URL=
# Port the digiquant dev server binds to.
DIGIQUANT_PORT=
# digisearch base URL as called by digichat.
DIGISEARCH_INTERNAL_URL=
# digitrace base URL as called by digichat.
DIGITRACE_INTERNAL_URL=
# CORS allowlist for the digigraph dev server.
DIGI_ALLOWED_ORIGINS=
# Browser-visible twin of DIGICHAT_TRACE_UI.
NEXT_PUBLIC_DIGICHAT_TRACE_UI=
# From address for notifications sent by the cron Worker.
NOTIFY_FROM=
# Credential for a non-local Ollama endpoint.
OLLAMA_API_KEY=
# OpenAI credential.
OPENAI_API_KEY=
# OpenRouter credential.
OPENROUTER_API_KEY=
# xAI credential.
XAI_API_KEY=

# --- worker (dashboard-api, digithings-stack) --------------------
# Shared Supabase project URL.
SUPABASE_URL=

# --- worker (digithings-cron) ------------------------------------
# `0` keeps POST /backfill returning 404; `1` exposes a production-writing surface.
BACKFILL_ENABLED=
# `1` makes cron jobs compute without writing.
DRY_RUN=
# Comma-separated job ids that regain workflow_dispatch. Empty means none.
GITHUB_OVERRIDE_JOBS=

# --- worker (digithings-digichat, digithings-stack) --------------
# Origins allowed to embed digichat. A closed list.
DIGICHAT_EMBED_HOSTS=
# Backends digichat may call. Deployed workers set `digigraph`; local dev enables four.
DIGICHAT_ENABLED_SERVICES=
# `0` allows the anonymous embed path.
DIGICHAT_REQUIRE_ROOT_AUTH=

# --- worker (digithings-stack) -----------------------------------
# Chroma persistence directory inside the container.
CHROMA_PATH=
# Allows one global dev key. `0` in production.
DIGIKEY_ALLOW_DEV_GLOBAL=0
# `0` in production; `1` only for local Docker via make stack-local.
DIGIKEY_ALLOW_EPHEMERAL_KEY=0
# Expected `aud` claim for every digikey-issued token.
DIGIKEY_AUDIENCE=digi-ecosystem
# Expected `iss` claim. Must match the URL services fetch JWKS from.
DIGIKEY_ISSUER=http://digikey:8005
# `r2` makes containers read the R2 market seam; `127` drops the Supabase tables.
DIGIQUANT_MARKET_DATA_BACKEND=
# digiquant base URL. Empty in the chat-only Profile A deployment.
DIGIQUANT_URL=
# Embedding model id. All three call sites must agree exactly (384 dims) or retrieval silently misses.
DIGISEARCH_EMBEDDING_PROVIDER=
# digisearch collection name. Must agree across ingest, backfill and query.
DIGISEARCH_INDEX=digithings_docs
# digisearch base URL as seen from its caller.
DIGISEARCH_URL=
# digitrace base URL. Empty in the chat-only Profile A deployment.
DIGITRACE_URL=
# digivault storage root inside the container.
DIGIVAULT_ROOT=/data/vault
# digivault base URL as seen from its caller.
DIGIVAULT_URL=
# LiteLLM routing mode. `test` keeps local runs off paid upstreams.
DIGI_LLM_MODE=test
# Per-tenant digisearch index and digivault prefix. Value copied verbatim from the stack Worker.
DIGI_TENANT_CORPUS_MAP=
# OpenAI-compatible base URL, pointing at LiteLLM inside the stack.
OPENAI_API_BASE=

# --- worker (digitrace-langfuse) ---------------------------------
# `false` runs single-node ClickHouse without ON CLUSTER.
CLICKHOUSE_CLUSTER_ENABLED=
# R2 bucket receiving Langfuse events.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=
# R2 path-style addressing.
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=
# Key prefix for Langfuse event objects.
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=
# `auto` is the R2 region convention.
LANGFUSE_S3_EVENT_UPLOAD_REGION=
