{
  "_readme": [
    "Committed state of the self-host <-> hosted parity checks (DIG-2767, plan section 8).",
    "Regenerate the `surface` block only with: scripts/self_host_parity.py --mode drift --update-baseline",
    "`migrations.knownFromEmptyFailures` is an EQUIVALENCE, not a ratchet: the migration",
    "check fails both on a failure that is not listed here and on a listed failure that has",
    "stopped happening. Never add an entry just to make a red check green: add the reason.",
    "This file records NAMES and binding KINDS only. No value, id or key of any kind."
  ],
  "measuredOn": {
    "note": "Measured on PostgreSQL 16 because the authoring host has no PG17 and no docker. CI runs the same chain on postgres:17; a failure that appears only on 17 is a real finding and will fail the check as NEW.",
    "pinnedMajorVersion": "17",
    "serverVersion": "16.15 (Homebrew)"
  },
  "migrations": {
    "appliedFromEmpty": 126,
    "excludedStaged": 2,
    "knownFromEmptyFailures": [
      {
        "class": "object-created-out-of-repo",
        "error": "ERROR:  relation 'public.fx_economic_calendar' does not exist",
        "migration": "031_fx_economic_calendar_rls.sql",
        "reason": "Its own header says fx_economic_calendar 'entered prod via an out-of-repo migration (001_fx_economic_calendar, 2026-06)'. 047_economic_calendar.sql line 18 calls it vestigial and unused; 128_db_cleanup_dead_tables.sql drops it. On a clean database the table does not exist yet, and 031 runs before the 128 that would remove it."
      },
      {
        "class": "object-created-out-of-repo",
        "error": "ERROR:  relation 'public.checkpoints' does not exist",
        "migration": "036_enable_rls_checkpointer_tables.sql",
        "reason": "public.checkpoints is a Langfuse checkpointer table that no migration in this repo creates."
      },
      {
        "class": "object-created-out-of-repo",
        "error": "ERROR:  relation 'public.olympus_schema_migrations' does not exist",
        "migration": "057_lock_migration_ledger.sql",
        "reason": "public.olympus_schema_migrations, the migration ledger itself, is not created by any file in this repo. This is the load-bearing one for self-host: there is no in-repo ledger to lock or to read."
      },
      {
        "class": "cascade-of-missing-table",
        "error": "ERROR:  relation 'public.checkpoints' does not exist",
        "migration": "061_checkpointer_retention.sql",
        "reason": "Same public.checkpoints gap as 036, and worth being precise about because it looks like a pg_cron problem: its two cron.schedule calls sit behind a pg_extension guard, so pg_cron is NOT why this fails. It fails on the ALTER of a table that no migration in this repo creates."
      },
      {
        "class": "supabase-only-object",
        "error": "ERROR:  migration 063: publication supabase_realtime does not exist",
        "migration": "063_prices_live_table.sql",
        "reason": "ADD PUBLICATION supabase_realtime: the publication exists on a managed Supabase project only."
      },
      {
        "class": "supabase-only-object",
        "error": "ERROR:  relation 'auth.users' does not exist",
        "migration": "107_ensure_personal_workspace.sql",
        "reason": "auth.users: the auth schema is part of Supabase Auth, not of PostgreSQL. The script's stub covers auth.uid() but not the auth.users table."
      },
      {
        "class": "cascade-of-missing-table",
        "error": "ERROR:  relation 'public.fx_economic_calendar' does not exist",
        "migration": "116_authenticated_read_public_reference.sql",
        "reason": "Same vestigial public.fx_economic_calendar gap as 031: it adds a policy to a table that only exists on the managed project because the table was created out of repo in 2026-06. Line 78 DROP POLICY IF EXISTS and line 79 CREATE POLICY, so the CREATE is the failing statement."
      },
      {
        "class": "cascade-of-failed-migration",
        "error": "ERROR:  function public.ensure_personal_workspace(uuid) does not exist",
        "migration": "117_security_advisor_now_pile.sql",
        "reason": "Cascade of 107: this file's policies call public.ensure_personal_workspace(uuid), which 107 defines, and 107 did not apply because it needs auth.users. Fixing 107 fixes this one too."
      },
      {
        "class": "object-created-out-of-repo",
        "error": "ERROR:  relation 'checkpoint_blobs' does not exist",
        "migration": "121_checkpoint_blobs_nullable.sql",
        "reason": "Same Langfime checkpointer gap as 036: public.checkpoint_blobs is altered here and created nowhere in this repo."
      },
      {
        "class": "cascade-of-missing-table",
        "error": "ERROR:  relation 'public.checkpoints' does not exist",
        "migration": "129_tighten_anon_read.sql",
        "reason": "Same public.checkpoints gap as 036: this file alters and re-policies a Langfuse checkpointer table that nothing in this repo creates."
      },
      {
        "class": "supabase-only-object",
        "error": "ERROR:  schema 'net' does not exist",
        "migration": "139_core_advisor_harden.sql",
        "reason": "schema \"net\" is pg_net, installed by Supabase. A self-hosted stack needs the extension added explicitly."
      }
    ],
    "totalMigrations": 137,
    "verdict": "The chain in this repo is NOT replayable from an empty database. 126 of 137 files apply; 11 need objects that exist only on the managed Supabase project or were created out of repo."
  },
